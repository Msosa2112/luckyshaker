<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.accent_pink | default: '#E82B7D' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="alternate icon" type="image/png" href="{{ 'lucky_shaker_glass_icon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'lucky_shaker_glass_icon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Google Fonts Typography (Cinzel, Playfair Display, Plus Jakarta Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Theme Core Stylesheet -->
    {{ 'lucky-shaker.css' | asset_url | stylesheet_tag }}

    <!-- Shopify Required Header Hook -->
    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.LuckyShaker = {
        routes: {
          cart_url: '{{ routes.cart_url }}',
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_update_url: '{{ routes.cart_update_url }}'
        },
        moneyFormat: {{ shop.money_format | json }},
        shopDomain: {{ shop.domain | json }},
        permanentDomain: {{ shop.permanent_domain | json }},
        assetUrlTemplate: {{ 'lucky-shaker.css' | asset_url | json }}.replace('lucky-shaker.css', 'frame-PLACEHOLDER.webp')
      };
    </script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <!-- Optical Glass Distortion Filter for SVG Backdrop Effects -->
    <svg style="position: absolute; width: 0; height: 0; pointer-events: none; opacity: 0; overflow: hidden;" aria-hidden="true" focusable="false">
      <filter id="glass-distortion" x="0%" y="0%" width="100%" height="100%" filterUnits="objectBoundingBox">
        <feTurbulence type="fractalNoise" baseFrequency="0.001 0.005" numOctaves="1" seed="17" result="turbulence" />
        <feComponentTransfer in="turbulence" result="mapped">
          <feFuncR type="gamma" amplitude="1" exponent="10" offset="0.5" />
          <feFuncG type="gamma" amplitude="0" exponent="1" offset="0" />
          <feFuncB type="gamma" amplitude="0" exponent="1" offset="0.5" />
        </feComponentTransfer>
        <feGaussianBlur in="turbulence" stdDeviation="3" result="softMap" />
        <feSpecularLighting in="softMap" surfaceScale="5" specularConstant="1" specularExponent="100" lightingColor="white" result="specLight">
          <fePointLight x="-200" y="-200" z="300" />
        </feSpecularLighting>
        <feComposite in="specLight" operator="arithmetic" k1="0" k2="1" k3="1" k4="0" result="litImage" />
        <feDisplacementMap in="SourceGraphic" in2="softMap" scale="200" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <!-- Header Section Group (Shopify OS 2.0 Compliance: Never wrap in conditional logic) -->
    {% sections 'header-group' %}

    <!-- Main Content Area -->
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer Section Group (Shopify OS 2.0 Compliance) -->
    {% sections 'footer-group' %}

    <!-- Global Cart Slide-Out Drawer Snippet -->
    {% render 'cart-drawer' %}

    <!-- Global Apple Liquid Toast Notification Snippet -->
    {% render 'toast-notification' %}

    <!-- 21+ Age Gate Verification Modal -->
    {%- if settings.enable_age_gate -%}
      {% render 'age-gate-modal' %}
    {%- endif -%}

    <!-- Lucky Shaker Instant Admin Portal Modal -->
    {% render 'admin-modal' %}

    <!-- GSAP & Theme Core Logic Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer="defer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer="defer"></script>
    <script src="{{ 'lucky-shaker.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
