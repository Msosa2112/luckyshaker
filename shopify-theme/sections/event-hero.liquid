<section id="hero" class="event-hero-section" data-section-id="{{ section.id }}">
  <div class="event-hero-media-wrap">
    <img src="{{ 'event-bartender-action.jpg' | asset_url }}" alt="Lucky Shaker Master Mixologist at Event" class="event-hero-bg-img" width="1920" height="1080" loading="eager" fetchpriority="high">
    <div class="event-hero-overlay"></div>
    <div class="event-hero-radial-glow"></div>
  </div>

  <div class="event-hero-content-container">
    <h1 class="event-hero-title">
      {{ section.settings.headline | default: 'HAZ QUE TU EVENTO<br><span class="highlight-pink">SEA MÁS LUCKY.</span>' }}
    </h1>

    <p class="event-hero-subtitle" data-i18n="hero.subtitle">
      {{ section.settings.subtitle | default: 'Servicio premium de barras móviles, coctelería de autor y hospitalidad inolvidable para bodas, fiestas privadas, galas corporativas y celebraciones.' }}
    </p>

    <div class="event-hero-ctas">
      <a href="#book-event" class="btn btn-pink btn-hero-primary" onclick="const f=document.getElementById('book-event'); if(f){ f.scrollIntoView({behavior:'smooth'}); return false; }">
        <span data-i18n="hero.primary_cta">{{ section.settings.primary_cta | default: 'COTIZAR TU EVENTO' }}</span>
        {% render 'icon', name: 'arrow-right', size: 14, class: 'btn-arrow', stroke_width: 2 %}
      </a>

      <a href="#cinematic-sequence" class="btn button-glass btn-hero-secondary" onclick="const s=document.getElementById('cinematic-sequence') || document.getElementById('shop-preview'); if(s){ s.scrollIntoView({behavior:'smooth'}); return false; }">
        <span data-i18n="hero.secondary_cta">{{ section.settings.secondary_cta | default: 'TIENDA ONLINE' }}</span>
        {% render 'icon', name: 'arrow-right', size: 14, class: 'btn-arrow', stroke_width: 1.8, style: 'margin-left: 0.35rem;' %}
      </a>
    </div>

    <div class="event-hero-trust-bar">
      <div class="trust-item">
        {% render 'icon', name: 'shield-check', size: 18, stroke: '#E82B7D', stroke_width: 2 %}
        <span data-i18n="hero.trust1">Barras Móviles de Lujo</span>
      </div>
      <div class="trust-item">
        {% render 'icon', name: 'clock', size: 18, stroke: '#E82B7D', stroke_width: 2 %}
        <span data-i18n="hero.trust2">Mixólogos de Autor Certificados</span>
      </div>
      <div class="trust-item">
        {% render 'icon', name: 'star', size: 18, stroke: '#E82B7D', stroke_width: 2 %}
        <span data-i18n="hero.trust3">Servicio 5 Estrellas</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Event Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LUCKY SHAKER — COCTELERÍA & BARTENDING DE AUTOR"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "HAZ QUE TU EVENTO<br><span class=\"highlight-pink\">SEA MÁS LUCKY.</span>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Servicio premium de barras móviles, coctelería de autor y hospitalidad inolvidable para bodas, fiestas privadas, galas corporativas y celebraciones."
    },
    {
      "type": "text",
      "id": "primary_cta",
      "label": "Primary CTA Label",
      "default": "COTIZAR TU EVENTO"
    },
    {
      "type": "text",
      "id": "secondary_cta",
      "label": "Secondary CTA Label",
      "default": "TIENDA ONLINE"
    }
  ],
  "presets": [
    {
      "name": "Event Hero"
    }
  ]
}
{% endschema %}
