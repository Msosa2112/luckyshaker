<section id="experience" class="event-experience-section" data-section-id="{{ section.id }}">
  <div class="event-experience-container">
    <div class="section-header-center">
      <span class="section-eyebrow" data-i18n="exp.eyebrow">{{ section.settings.eyebrow | default: 'MÁS QUE UNA BARRA' }}</span>
      <h2 class="section-title" data-i18n="exp.headline">{{ section.settings.headline | default: 'La Experiencia Lucky Shaker' }}</h2>
      <p class="section-subtitle" data-i18n="exp.subtitle">
        {{ section.settings.subtitle | default: 'Gestionamos cada aspecto de la logística de barra, la coreografía de mixología y el servicio para que puedas disfrutar plenamente con tus invitados.' }}
      </p>
    </div>

    <div class="experience-steps-grid">
      <!-- Paso 01 -->
      <div class="exp-step-item">
        <div class="step-badge">01</div>
        <div class="step-icon-circle">
          {% render 'icon', name: 'star', size: 15, stroke: '#E82B7D', fill: '#E82B7D', stroke_width: 1.5 %}
        </div>
        <h3 class="step-name" data-i18n="exp.s4_title">{{ section.settings.s4_title | default: '04 &bull; CELEBRA' }}</h3>
        <p class="step-text" data-i18n="exp.s4_desc">
          {{ section.settings.s4_desc | default: 'Cero estrés para el anfitrión. Disfruta de un servicio fluido, invitados fascinados y un desmontaje de barra limpio al finalizar la noche.' }}
        </p>
      </div>
    </div>

    <div class="experience-cta-wrap">
      <a href="#book-event" class="btn btn-pink" onclick="const f=document.getElementById('book-event'); if(f){ f.scrollIntoView({behavior:'smooth'}); return false; }">
        <span data-i18n="exp.book_btn">COTIZAR TU EVENTO</span>
        {% render 'icon', name: 'arrow-right', size: 14, class: 'btn-arrow', stroke_width: 1.8 %}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Experiencia de Bartending",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "MÁS QUE UNA BARRA"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Título Principal",
      "default": "La Experiencia Lucky Shaker"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Gestionamos cada aspecto de la logística de barra, la coreografía de mixología y el servicio para que puedas disfrutar plenamente con tus invitados."
    },
    {
      "type": "text",
      "id": "s1_title",
      "label": "Paso 1 Título",
      "default": "01 • PLANIFICA"
    },
    {
      "type": "textarea",
      "id": "s1_desc",
      "label": "Paso 1 Descripción",
      "default": "Asesoría personalizada de menú. Diseñamos cócteles de autor que combinan con la temática de tu evento, el perfil de los invitados y el estilo del lugar."
    },
    {
      "type": "text",
      "id": "s2_title",
      "label": "Paso 2 Título",
      "default": "02 • PREPARA"
    },
    {
      "type": "textarea",
      "id": "s2_desc",
      "label": "Paso 2 Descripción",
      "default": "Jarabes botánicos artesanales, cítricos recién exprimidos, hielo artesanal cristalino, garnituras exclusivas y montaje de la barra antes de que lleguen los invitados."
    },
    {
      "type": "text",
      "id": "s3_title",
      "label": "Paso 3 Título",
      "default": "03 • AGITA"
    },
    {
      "type": "textarea",
      "id": "s3_desc",
      "label": "Paso 3 Descripción",
      "default": "Arte de coctelera y hospitalidad de alto nivel. Cada cóctel se agita al momento con dinamismo, precisión y una presentación impecable."
    },
    {
      "type": "text",
      "id": "s4_title",
      "label": "Paso 4 Título",
      "default": "04 • CELEBRA"
    },
    {
      "type": "textarea",
      "id": "s4_desc",
      "label": "Paso 4 Descripción",
      "default": "Cero estrés para el anfitrión. Disfruta de un servicio fluido, invitados fascinados y un desmontaje de barra limpio al finalizar la noche."
    }
  ],
  "presets": [
    {
      "name": "Experiencia de Bartending"
    }
  ]
}
{% endschema %}
