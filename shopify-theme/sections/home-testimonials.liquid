<section class="home-testimonials-section" data-section-id="{{ section.id }}">
  <div class="testimonials-container">
    <div class="testimonials-header-center">
      <span class="section-eyebrow">{{ section.settings.eyebrow | default: 'CONNOISSEUR PRAISE' }}</span>
      <h2 class="section-title">{{ section.settings.headline | default: 'Loved by Discerning Palates.' }}</h2>
      <div class="testimonials-rating-badge">
        <div class="stars-gold">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#E82B7D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#E82B7D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#E82B7D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#E82B7D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#E82B7D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <span>4.96 / 5.0 Average Rating Across 180+ Orders</span>
      </div>
    </div>

    <div class="testimonials-cards-grid">
      <!-- Review 1 -->
      <div class="testimonial-card">
        <div class="test-stars">
          ★★★★★
        </div>
        <p class="test-quote">
          &ldquo;{{ section.settings.r1_quote | default: 'The Whiskey Cream is extraordinary. It completely outclasses any commercial liqueur on the market. Velvety, authentic cocoa aroma, and balanced whiskey warmth.' }}&rdquo;
        </p>
        <div class="test-author-row">
          <div class="test-author-info">
            <span class="test-name">{{ section.settings.r1_author | default: 'Marcus V.' }}</span>
            <span class="test-role">Verified Connoisseur &bull; Miami, FL</span>
          </div>
          <span class="test-verified-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Verified
          </span>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="testimonial-card">
        <div class="test-stars">
          ★★★★★
        </div>
        <p class="test-quote">
          &ldquo;{{ section.settings.r2_quote | default: 'We ordered the Private Reserve Trio for an anniversary dinner. Being able to shake and pour a world-class Old Fashioned without touching a muddler was magic.' }}&rdquo;
        </p>
        <div class="test-author-row">
          <div class="test-author-info">
            <span class="test-name">{{ section.settings.r2_author | default: 'Elena S.' }}</span>
            <span class="test-role">Verified Connoisseur &bull; New York, NY</span>
          </div>
          <span class="test-verified-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Verified
          </span>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="testimonial-card">
        <div class="test-stars">
          ★★★★★
        </div>
        <p class="test-quote">
          &ldquo;{{ section.settings.r3_quote | default: 'The Mojito has genuine fresh garden mint character and real cold-pressed lime zest. The packaging arrived perfectly chilled in pristine condition.' }}&rdquo;
        </p>
        <div class="test-author-row">
          <div class="test-author-info">
            <span class="test-name">{{ section.settings.r3_author | default: 'David K.' }}</span>
            <span class="test-role">Verified Connoisseur &bull; Los Angeles, CA</span>
          </div>
          <span class="test-verified-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Verified
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CONNOISSEUR PRAISE"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Loved by Discerning Palates."
    },
    {
      "type": "header",
      "content": "Review 1"
    },
    {
      "type": "textarea",
      "id": "r1_quote",
      "label": "Quote",
      "default": "The Whiskey Cream is extraordinary. It completely outclasses any commercial liqueur on the market. Velvety, authentic cocoa aroma, and balanced whiskey warmth."
    },
    {
      "type": "text",
      "id": "r1_author",
      "label": "Author",
      "default": "Marcus V."
    },
    {
      "type": "header",
      "content": "Review 2"
    },
    {
      "type": "textarea",
      "id": "r2_quote",
      "label": "Quote",
      "default": "We ordered the Private Reserve Trio for an anniversary dinner. Being able to shake and pour a world-class Old Fashioned without touching a muddler was magic."
    },
    {
      "type": "text",
      "id": "r2_author",
      "label": "Author",
      "default": "Elena S."
    },
    {
      "type": "header",
      "content": "Review 3"
    },
    {
      "type": "textarea",
      "id": "r3_quote",
      "label": "Quote",
      "default": "The Mojito has genuine fresh garden mint character and real cold-pressed lime zest. The packaging arrived perfectly chilled in pristine condition."
    },
    {
      "type": "text",
      "id": "r3_author",
      "label": "Author",
      "default": "David K."
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
