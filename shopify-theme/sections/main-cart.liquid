<section class="cart-page-container" data-section-id="{{ section.id }}">
  <div class="cart-header-row">
    <h1 class="cart-main-title">{{ 'sections.cart.title' | t }}</h1>
    <span class="cart-count-badge">{{ cart.item_count }} {% if cart.item_count == 1 %}BOTTLE{% else %}BOTTLES{% endif %}</span>
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="cart-empty-state" style="text-align: center; padding: 5rem 1rem;">
      <div style="display: flex; justify-content: center; margin-bottom: 1.25rem; color: var(--accent-pink);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c0 4.42-3.58 8-8 8s-8-3.58-8-8z"/>
          <line x1="12" y1="12" x2="12" y2="20"/>
          <line x1="8" y1="20" x2="16" y2="20"/>
        </svg>
      </div>
      <h2 style="font-family: var(--font-brand); font-size: 1.5rem; margin-bottom: 0.5rem;">{{ 'sections.cart.empty' | t }}</h2>
      <p style="color: var(--text-muted); margin-bottom: 2rem;">{{ 'sections.cart.explore' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-pink" style="display: inline-flex;">
        <span>EXPLORE SIGNATURE COCKTAILS</span>
      </a>
    </div>
  {%- else -%}
    <!-- Free Shipping Progress Tracker -->
    {%- assign threshold = 7500 -%}
    {%- assign remaining = threshold | minus: cart.total_price -%}
    <div class="shipping-progress-card">
      <div class="shipping-progress-text">
        {%- if remaining <= 0 -%}
          <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right:5px;"><polyline points="20 6 9 17 4 12"></polyline></svg><strong>Complimentary Express Courier Delivery Unlocked!</strong> (Orders $75+)</span>
        {%- else -%}
          <span>Add <strong>{{ remaining | money }}</strong> more to unlock <strong>Complimentary 21+ Express Delivery</strong></span>
        {%- endif -%}
      </div>
      <div class="shipping-progress-track">
        {%- assign percent = cart.total_price | times: 100 | divided_by: threshold -%}
        {%- if percent > 100 %}{% assign percent = 100 %}{% endif -%}
        <div class="shipping-progress-fill" style="width: {{ percent }}%;"></div>
      </div>
    </div>

    <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="cart-full-layout">
      <!-- Items Table -->
      <div class="cart-table-card">
        <table class="cart-items-table">
          <thead>
            <tr>
              <th>COCKTAIL</th>
              <th>FORMAT</th>
              <th>PRICE</th>
              <th>QUANTITY</th>
              <th>TOTAL</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr class="cart-row" data-line-item-key="{{ item.key }}">
                <td class="cart-product-cell">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title }}" class="cart-cell-thumb" width="70" height="85">
                  {%- endif -%}
                  <div class="cart-cell-meta">
                    <a href="{{ item.url }}" class="cart-cell-name">{{ item.product.title }}</a>
                    <span class="cart-cell-sub">Small-Batch Ready-to-Pour</span>
                  </div>
                </td>
                <td class="cart-format-cell">{{ item.variant.title }}</td>
                <td class="cart-price-cell">{{ item.price | money }}</td>
                <td class="cart-qty-cell">
                  <div class="cart-qty-wrapper">
                    <button type="button" class="cart-qty-btn" onclick="LuckyShakerCart.changeQuantity('{{ item.key }}', {{ item.quantity | minus: 1 }})">&minus;</button>
                    <span class="cart-qty-num">{{ item.quantity }}</span>
                    <button type="button" class="cart-qty-btn" onclick="LuckyShakerCart.changeQuantity('{{ item.key }}', {{ item.quantity | plus: 1 }})">&plus;</button>
                  </div>
                </td>
                <td class="cart-line-total">{{ item.final_line_price | money }}</td>
                <td class="cart-remove-cell">
                  <button type="button" class="cart-remove-btn" onclick="LuckyShakerCart.changeQuantity('{{ item.key }}', 0)" title="Remove item">
                    &times;
                  </button>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <!-- Gift Note -->
        <div class="cart-gift-note-card">
          <label for="CartNote" class="cart-note-label">COMPLIMENTARY EMBOSSED GIFT NOTE &amp; DELIVERY INSTRUCTIONS</label>
          <textarea id="CartNote" name="note" class="cart-note-input" placeholder="Enter recipient name and your personalized message (up to 200 characters)...">{{ cart.note }}</textarea>
        </div>
      </div>

      <!-- Order Summary Aside -->
      <aside class="cart-summary-card">
        <h3 class="summary-title">ORDER SUMMARY</h3>
        
        <div class="summary-line">
          <span>Subtotal</span>
          <span class="summary-val">{{ cart.total_price | money }}</span>
        </div>

        <div class="summary-line">
          <span>Estimated 21+ Courier Shipping</span>
          <span class="summary-val">{% if remaining <= 0 %}FREE{% else %}Calculated at checkout{% endif %}</span>
        </div>

        <div class="summary-line">
          <span>State Liquor Excise &amp; Tax</span>
          <span class="summary-val">Calculated at checkout</span>
        </div>

        <div class="summary-divider"></div>

        <div class="summary-total-row">
          <span>TOTAL</span>
          <span class="summary-total-val">{{ cart.total_price | money }}</span>
        </div>

        <button type="submit" name="checkout" class="btn btn-pink summary-checkout-btn" style="width: 100%;">
          <span>CHECKOUT NOW</span>
          {% render 'icon', name: 'arrow-right', size: 14, class: 'btn-arrow', stroke_width: 1.8 %}
        </button>

        <div class="summary-guarantee-list">
          <div class="summary-guarantee-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-pink); flex-shrink: 0;" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>256-Bit SSL Encrypted &amp; Direct-to-Consumer Alcohol Certified</span>
          </div>
          <div class="summary-guarantee-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-pink); flex-shrink: 0;" aria-hidden="true">
              <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/>
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
            <span>Temperature-Stabilized Breakage-Proof Packaging</span>
          </div>
          <div class="summary-guarantee-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-pink); flex-shrink: 0;" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M7.5 12h2.5a1.5 1.5 0 0 0 0-3H8v6h3"/>
              <path d="M14 9h2v6"/>
              <line x1="13" y1="15" x2="17" y2="15"/>
            </svg>
            <span>Mandatory 21+ Adult Signature Upon Handover</span>
          </div>
        </div>
      </aside>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
