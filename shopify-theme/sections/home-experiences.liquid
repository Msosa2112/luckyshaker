    },
    {
      "type": "text",
      "id": "exp3_title",
      "label": "Title",
      "default": "Mixology Masterclasses"
    },
    {
      "type": "textarea",
      "id": "exp3_desc",
      "label": "Description",
      "default": "Learn the secrets of craft cocktail emulsion, ice clarity, shaker physics, and botanical extraction from master mixologist Katherin."
    },
    {
      "type": "image_picker",
      "id": "exp3_img",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "exp3_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Experiences & Booking"
    }
  ]
