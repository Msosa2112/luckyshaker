<section id="events" class="event-types-section" data-section-id="{{ section.id }}">
  <div class="event-types-container">
    {%- if section.settings.show_header -%}
      <div class="section-header-center">
        <span class="section-eyebrow" data-i18n="types.eyebrow">{{ section.settings.eyebrow | default: 'CREADO PARA TU MOMENTO' }}</span>
        <h2 class="section-title" data-i18n="types.headline">{{ section.settings.headline | default: 'Coctelería a Medida para Cada Ocasión' }}</h2>
        <p class="section-subtitle" data-i18n="types.subtitle">
          {{ section.settings.subtitle | default: 'Desde celebraciones íntimas hasta grandes recepciones de bodas, adaptamos cada cóctel, estación de barra y detalle de hospitalidad a tu evento.' }}
        </p>
      </div>
    {%- endif -%}

    <!-- LUMINA WEBGL INTERACTIVE SLIDER (EXACT REFERENCE DESIGN) -->
    <main class="slider-wrapper" id="luminaSliderWrapper" data-auto-slide="{{ section.settings.auto_slide_speed | default: 5000 }}" data-transition-duration="{{ section.settings.transition_duration | default: 2.5 }}">
      <canvas class="webgl-canvas" id="luminaCanvas"></canvas>
      
      <!-- Static poster fallback -->
      <div class="slider-poster-fallback" id="sliderFallback" style="background-image: url('{{ 'event-real-bodas.jpg' | asset_url }}');"></div>

      <!-- Left & Right Vertically Centered Numbers -->
      <span class="slide-number" id="slideNumber">01</span>
      <span class="slide-total" id="slideTotal">04</span>
      
      <!-- Dead-Center Title, Description & Floating Gallery Pill (Clickable to open Gallery) -->
      <div class="slide-content" id="slideContent" role="button" tabindex="0" title="Toca para ver galería completa">
        <h2 class="slide-title" id="mainTitle"></h2>
        <p class="slide-description" id="mainDesc"></p>
        
        <div class="slide-gallery-trigger">
          <span class="gallery-hint-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <span data-i18n="types.view_gallery">TOCA PARA VER GALERÍA COMPLETA</span>
          </span>
        </div>
      </div>
     
      <!-- Bottom Categories Navigation Bar -->
      <nav class="slides-navigation" id="slidesNav" aria-label="Categorías de Eventos"></nav>
    </main>
  </div>

  <!-- EVENT PHOTO GALLERY LIGHTBOX MODAL -->
  <div class="event-gallery-modal" id="eventGalleryModal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-backdrop" id="modalBackdrop"></div>
    
    <div class="modal-dialog">
      <!-- Modal Header -->
      <div class="modal-header">
        <div class="modal-header-info">
          <span class="modal-eyebrow" id="modalEyebrow">GALERÍA EXCLUSIVA</span>
          <h3 class="modal-title" id="modalCatTitle">Bodas &amp; Recepciones</h3>
          <p class="modal-subtitle" id="modalCatSub" data-i18n="types.gallery_modal_sub">Momentos reales de eventos por Lucky Shaker</p>
        </div>

        <div class="modal-header-actions">
          <a href="#book-event" class="btn btn-pink modal-quote-btn" id="modalQuoteBtn">
            <span data-i18n="types.modal_quote_btn">COTIZAR ESTE EVENTO</span>
            <svg class="btn-arrow" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M8 2l5 5-5 5"/></svg>
          </a>
          <button type="button" class="modal-close-btn" id="modalCloseBtn" aria-label="Cerrar galería">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      <!-- Main Showcase Viewer -->
      <div class="modal-viewer">
        <button type="button" class="modal-nav-arrow modal-prev-btn" id="modalPrevBtn" aria-label="Foto anterior">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        </button>

        <div class="modal-image-stage" id="modalImageStage">
          <img id="modalMainImg" class="modal-main-image" src="" alt="Foto de evento Lucky Shaker">
          <div class="modal-image-loader" id="modalImgLoader"></div>
        </div>

        <button type="button" class="modal-nav-arrow modal-next-btn" id="modalNextBtn" aria-label="Foto siguiente">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

      <!-- Caption & Counter Bar -->
      <div class="modal-caption-bar">
        <span class="modal-caption-text" id="modalCaptionText"></span>
        <span class="modal-counter-badge" id="modalCounterBadge">01 / 06</span>
      </div>

      <!-- Bottom Filmstrip Thumbnails -->
      <div class="modal-filmstrip-wrapper">
        <div class="modal-filmstrip" id="modalFilmstrip"></div>
      </div>
    </div>
  </div>
</section>

<style>
/* ==========================================================================
   LUMINA INTERACTIVE SLIDER & PHOTO GALLERY MODAL
   ========================================================================== */
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap');

.event-types-section {
  position: relative;
  background: var(--bg-deep, #FAFAFC);
  padding: 4.5rem 0 6rem;
  overflow: hidden;
}

.event-types-container {
  max-width: var(--container-max, 1440px);
  margin: 0 auto;
  padding: 0 var(--gutter, clamp(1.25rem, 4vw, 3.5rem));
}

.section-header-center {
  text-align: center;
  max-width: 740px;
  margin: 0 auto 3.5rem;
}

/* Main Slider Wrapper */
.slider-wrapper {
  position: relative;
  width: 100%;
  height: 75vh;
  min-height: 580px;
  max-height: 780px;
  border-radius: 28px;
  overflow: hidden;
  background: #000000;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28), 0 0 0 1px rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  isolation: isolate;
  user-select: none;
  cursor: pointer;
}

.webgl-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 1;
  opacity: 0;
  transition: opacity 0.8s ease;
}

.slider-wrapper.loaded .webgl-canvas {
  opacity: 1;
}

.slider-poster-fallback {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  z-index: 0;
  transition: opacity 0.8s ease;
}

.slider-wrapper.loaded .slider-poster-fallback {
  opacity: 0;
}

/* Subtle dark vignette to ensure text readability */
.slider-wrapper::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, rgba(0, 0, 0, 0.12) 0%, rgba(0, 0, 0, 0.42) 75%, rgba(0, 0, 0, 0.7) 100%),
              linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, transparent 25%, transparent 65%, rgba(0, 0, 0, 0.65) 100%);
  z-index: 2;
  pointer-events: none;
}

/* Left and Right Numbers */
.slide-number,
.slide-total {
