<section id="events" class="event-types-section lumina-slider-section" data-section-id="{{ section.id }}">
  <div class="event-types-container">
    <div class="section-header-center">
      <span class="section-eyebrow" data-i18n="types.eyebrow">{{ section.settings.eyebrow | default: 'CREADO PARA TU MOMENTO' }}</span>
      <h2 class="section-title" data-i18n="types.headline">{{ section.settings.headline | default: 'Coctelería a Medida para Cada Ocasión' }}</h2>
      <p class="section-subtitle" data-i18n="types.subtitle">
        {{ section.settings.subtitle | default: 'Desde celebraciones íntimas hasta grandes recepciones de bodas, adaptamos cada cóctel, estación de barra y detalle de hospitalidad a tu evento.' }}
      </p>
    </div>

    <!-- LUMINA WEBGL INTERACTIVE SLIDER -->
    <div class="lumina-slider-wrapper" id="luminaSliderWrapper" data-auto-slide="{{ section.settings.auto_slide_speed | default: 5500 }}" data-transition-duration="{{ section.settings.transition_duration | default: 1.8 }}">
      <!-- WebGL Canvas -->
      <canvas class="lumina-webgl-canvas" id="luminaCanvas"></canvas>
      
      <!-- Static poster image for instant first-paint & fallback -->
      <div class="lumina-poster-fallback" id="luminaFallback" style="background-image: url('{{ 'event-weddings.jpg' | asset_url }}');"></div>

      <!-- Luxury Ambient Gradient Overlays -->
      <div class="lumina-gradient-overlay"></div>
      <div class="lumina-vignette-overlay"></div>

      <!-- Top Meta Bar: Tag Badge & Number Counter -->
      <div class="lumina-meta-bar">
        <div class="lumina-tag-badge" id="slideTag">ELEGANTE &bull; MEMORABLE</div>
        <div class="lumina-counter">
          <span class="slide-number" id="slideNumber">01</span>
          <span class="slide-divider">/</span>
          <span class="slide-total" id="slideTotal">04</span>
        </div>
      </div>

      <!-- Center-Left Floating Editorial Content Card -->
      <div class="lumina-content-stage">
        <div class="lumina-content-glass-card">
          <h3 class="lumina-slide-title" id="mainTitle">Bodas &amp; Recepción</h3>
          <p class="lumina-slide-desc" id="mainDesc">Servicio integral de coctelería de lujo con cócteles personalizados para los novios, cristalería de cristal, servicio de champaña y mixólogos de autor.</p>
          <div class="lumina-actions">
            <a href="#book-event" class="btn btn-pink lumina-quote-btn" id="mainQuoteBtn">
              <span data-i18n="types.quote_btn">SOLICITAR COTIZACIÓN</span>
              <svg class="btn-arrow" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M8 2l5 5-5 5"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom Category Navigation Bar with 4 Categories & Progress Indicators -->
      <nav class="lumina-slides-nav" id="slidesNav" aria-label="Categorías de Eventos"></nav>
    </div>
  </div>
</section>

<style>
/* ==========================================================================
   LUMINA INTERACTIVE WEBGL SLIDER STYLES
   ========================================================================== */
.lumina-slider-section {
  position: relative;
  background: var(--bg-deep, #FAFAFC);
  overflow: hidden;
  padding: 5.5rem 0 6.5rem;
}

.lumina-slider-wrapper {
  position: relative;
  width: 100%;
  min-height: 580px;
  height: 68vh;
  max-height: 720px;
  border-radius: 28px;
  overflow: hidden;
  background: #0B0C0E;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22), 0 0 0 1px rgba(0, 0, 0, 0.08);
  isolation: isolate;
  user-select: none;
}

.lumina-webgl-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 1;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.8s ease;
}

.lumina-slider-wrapper.loaded .lumina-webgl-canvas {
  opacity: 1;
}

.lumina-poster-fallback {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  z-index: 0;
  transition: opacity 0.8s ease;
}

.lumina-slider-wrapper.loaded .lumina-poster-fallback {
  opacity: 0;
}

/* Ambient Overlays */
.lumina-gradient-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(11, 12, 14, 0.25) 0%, rgba(11, 12, 14, 0.4) 40%, rgba(11, 12, 14, 0.88) 100%),
              linear-gradient(90deg, rgba(11, 12, 14, 0.75) 0%, rgba(11, 12, 14, 0.25) 55%, rgba(11, 12, 14, 0.4) 100%);
