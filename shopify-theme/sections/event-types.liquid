<section id="events" class="event-types-section" data-section-id="{{ section.id }}">
  <div class="event-types-container">
    {%- if section.settings.show_header -%}
      <div class="section-header-center">
        <span class="section-eyebrow" data-i18n="types.eyebrow">{{ section.settings.eyebrow | default: 'CREADO PARA TU MOMENTO' }}</span>
        <h2 class="section-title" data-i18n="types.headline">{{ section.settings.headline | default: 'Coctelería a Medida para Cada Ocasión' }}</h2>
        <p class="section-subtitle" data-i18n="types.subtitle">
          {{ section.settings.subtitle | default: 'Desde celebraciones íntimas hasta grandes recepciones de bodas, adaptamos cada cóctel, estación de barra y detalle de hospitalidad a tu evento.' }}
        </p>
      </div>
    {%- endif -%}

    <!-- LUMINA WEBGL INTERACTIVE SLIDER (EXACT REFERENCE DESIGN) -->
    <main class="slider-wrapper" id="luminaSliderWrapper" data-auto-slide="{{ section.settings.auto_slide_speed | default: 5000 }}" data-transition-duration="{{ section.settings.transition_duration | default: 2.5 }}">
      <canvas class="webgl-canvas" id="luminaCanvas"></canvas>
      
      <!-- Static poster fallback -->
      <div class="slider-poster-fallback" id="sliderFallback" style="background-image: url('{{ 'event-real-bodas.jpg' | asset_url }}');"></div>

      <!-- Left & Right Vertically Centered Counters -->
      <span class="slide-number" id="slideNumber">01</span>
      <span class="slide-total" id="slideTotal">04</span>
      
      <!-- Dead-Center Title & Description (Clickable to Booking Form) -->
      <div class="slide-content" id="slideContent" role="button" tabindex="0" title="Cotizar este evento">
        <h2 class="slide-title" id="mainTitle"></h2>
        <p class="slide-description" id="mainDesc"></p>
      </div>
     
      <!-- Bottom Categories Navigation Bar -->
      <nav class="slides-navigation" id="slidesNav" aria-label="Categorías de Eventos"></nav>
    </main>
  </div>
</section>

<style>
/* ==========================================================================
   LUMINA INTERACTIVE SLIDER — PIXEL-PERFECT LUXURY REPLICATION
   ========================================================================== */
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap');

.event-types-section {
  position: relative;
  background: var(--bg-deep, #FAFAFC);
  padding: 4.5rem 0 6rem;
  overflow: hidden;
}

.event-types-container {
  max-width: var(--container-max, 1440px);
  margin: 0 auto;
  padding: 0 var(--gutter, clamp(1.25rem, 4vw, 3.5rem));
}

.section-header-center {
  text-align: center;
  max-width: 740px;
  margin: 0 auto 3.5rem;
}

/* Main Slider Wrapper */
.slider-wrapper {
  position: relative;
  width: 100%;
  height: 75vh;
  min-height: 580px;
  max-height: 780px;
  border-radius: 28px;
  overflow: hidden;
  background: #000000;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28), 0 0 0 1px rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  isolation: isolate;
  user-select: none;
}

.webgl-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 1;
  opacity: 0;
  transition: opacity 0.8s ease;
}

.slider-wrapper.loaded .webgl-canvas {
  opacity: 1;
}

.slider-poster-fallback {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  z-index: 0;
  transition: opacity 0.8s ease;
}

.slider-wrapper.loaded .slider-poster-fallback {
  opacity: 0;
}

/* Subtle dark vignette to ensure text readability while preserving full imagery */
.slider-wrapper::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.45) 75%, rgba(0, 0, 0, 0.7) 100%),
              linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, transparent 25%, transparent 65%, rgba(0, 0, 0, 0.65) 100%);
  z-index: 2;
  pointer-events: none;
}

/* Left and Right Vertically Centered Numbers */
.slide-number,
.slide-total {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-family: 'Cinzel', serif;
  font-size: clamp(1rem, 1.4vw, 1.25rem);
  font-weight: 500;
  letter-spacing: 0.22em;
  color: rgba(255, 255, 255, 0.75);
  z-index: 10;
  pointer-events: none;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
}

.slide-number {
  left: clamp(1.8rem, 3.5vw, 3.5rem);
}

.slide-total {
  right: clamp(1.8rem, 3.5vw, 3.5rem);
}

/* Center Content: Title & Description */
.slide-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 10;
  width: 88%;
  max-width: 860px;
  cursor: pointer;
  padding: 1rem;
}

.slide-title {
  font-family: 'Playfair Display', 'Cinzel', serif;
  font-size: clamp(2.6rem, 5.5vw, 5.2rem);
  font-weight: 400;
  color: #FFFFFF;
  line-height: 1.12;
  margin: 0 0 1.25rem 0;
  letter-spacing: -0.01em;
  text-shadow: 0 4px 28px rgba(0, 0, 0, 0.65), 0 2px 6px rgba(0, 0, 0, 0.5);
}

.slide-title span {
  display: inline-block;
  will-change: transform, opacity, filter;
}

.slide-description {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: clamp(0.95rem, 1.25vw, 1.2rem);
  font-weight: 400;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.65;
  margin: 0 auto;
  max-width: 620px;
  text-shadow: 0 2px 18px rgba(0, 0, 0, 0.75);
  letter-spacing: 0.015em;
}

/* Bottom 4 Categories Navigation */
.slides-navigation {
  position: absolute;
  bottom: 2.5rem;
  left: clamp(2rem, 4vw, 4rem);
  right: clamp(2rem, 4vw, 4rem);
  display: flex;
  justify-content: space-between;
  gap: clamp(1rem, 2.5vw, 2.5rem);
  z-index: 10;
}

.slide-nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  cursor: pointer;
  opacity: 0.45;
  transition: opacity 0.35s ease, transform 0.25s ease;
  user-select: none;
  text-align: left;
}

.slide-nav-item:hover {
  opacity: 0.85;
}

.slide-nav-item.active {
  opacity: 1;
}

.slide-progress-line {
  width: 100%;
  height: 1.5px;
  background: rgba(255, 255, 255, 0.25);
  position: relative;
  overflow: hidden;
  border-radius: 1px;
}

.slide-progress-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 0%;
  background: #FFFFFF;
  border-radius: 1px;
  transition: width 0.05s linear;
}

.slide-nav-title {
  font-family: 'Cinzel', serif;
  font-size: clamp(0.68rem, 0.85vw, 0.78rem);
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #FFFFFF;
  line-height: 1.35;
  white-space: normal;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
}

/* ==========================================================================
   RESPONSIVE
   ========================================================================== */
@media (max-width: 1024px) {
  .slider-wrapper {
    height: 70vh;
    min-height: 520px;
  }
  .slides-navigation {
    bottom: 2rem;
  }
}

@media (max-width: 768px) {
  .event-types-section {
    padding: 3rem 0 4.5rem;
  }
  .slider-wrapper {
    height: 78vh;
    min-height: 500px;
    border-radius: 20px;
  }
  .slide-number {
    left: 1.25rem;
  }
  .slide-total {
    right: 1.25rem;
  }
  .slide-content {
    width: 90%;
  }
  .slide-title {
    font-size: 2.35rem;
    margin-bottom: 0.85rem;
  }
  .slide-description {
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .slides-navigation {
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    gap: 0.5rem;
  }
  .slide-nav-item {
    gap: 0.5rem;
  }
  .slide-nav-title {
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-align: center;
  }
}
</style>

<script>
(function() {
  // --- DYNAMIC SCRIPT LOADER ---
  const loadScript = (src, globalName) => new Promise((res, rej) => {
    if (window[globalName]) { res(); return; }
    if (document.querySelector(`script[src="${src}"]`)) {
      const check = setInterval(() => {
        if (window[globalName]) { clearInterval(check); res(); }
      }, 50);
      setTimeout(() => { clearInterval(check); rej(new Error(`Timeout waiting for ${globalName}`)); }, 10000);
      return;
    }
    const s = document.createElement('script');
    s.src = src;
    s.onload = () => { setTimeout(() => res(), 50); };
    s.onerror = () => rej(new Error(`Failed to load ${src}`));
    document.head.appendChild(s);
  });

  const initLuminaSlider = async () => {
    try {
      if (!window.gsap) {
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js', 'gsap');
      }
      if (!window.THREE) {
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js', 'THREE');
      }
    } catch (e) {
      console.error('Failed to load base scripts:', e);
    }

    const wrapper = document.getElementById('luminaSliderWrapper');
    const canvas = document.getElementById('luminaCanvas');
    if (!wrapper || !canvas || !window.THREE) return;

    // --- CONFIGURATION ---
    const SLIDER_CONFIG = {
      settings: {
        transitionDuration: parseFloat(wrapper.dataset.transitionDuration) || 2.5,
        autoSlideSpeed: parseInt(wrapper.dataset.autoSlide, 10) || 5000,
        currentEffect: "glass",
        currentEffectPreset: "Default",
        globalIntensity: 1.0,
        speedMultiplier: 1.0,
        distortionStrength: 1.0,
        colorEnhancement: 1.0,
        glassRefractionStrength: 1.0,
        glassChromaticAberration: 1.0,
        glassBubbleClarity: 1.0,
        glassEdgeGlow: 1.0,
        glassLiquidFlow: 1.0
      }
    };

    // --- 4 CATEGORIES & SLIDES DATA ---
    const slides = [
      {
        categoryKey: 'types.cat_1',
        categoryDefault: 'Bodas',
        titleKey: 'types.c1_title',
        titleDefault: 'Bodas & Recepción',
        descKey: 'types.c1_desc',
        descDefault: 'Servicio integral de coctelería de lujo con cócteles personalizados para los novios, cristalería fina y mixólogos de autor.',
        media: "{{ 'event-real-bodas.jpg' | asset_url }}",
        formValue: 'Boda'
      },
      {
        categoryKey: 'types.cat_2',
        categoryDefault: 'Gender Reveal',
        titleKey: 'types.c2_title',
        titleDefault: 'Gender Reveal',
        descKey: 'types.c2_desc',
        descDefault: 'Celebraciones mágicas con coctelería temática, mocktails de autor sin alcohol y estaciones de barra personalizadas para la revelación.',
        media: "{{ 'event-real-gender-reveal.jpg' | asset_url }}",
        formValue: 'Gender Reveal'
      },
      {
        categoryKey: 'types.cat_3',
        categoryDefault: 'Evento de Negocios',
        titleKey: 'types.c3_title',
        titleDefault: 'Evento de Negocios',
        descKey: 'types.c3_desc',
        descDefault: 'Mixología profesional de alto volumen, activación de marca en barra, servicio ágil y hospitalidad ejecutiva para invitados VIP.',
        media: "{{ 'event-real-negocios.jpg' | asset_url }}",
        formValue: 'Evento Corporativo'
      },
      {
        categoryKey: 'types.cat_4',
        categoryDefault: 'Fiestas',
        titleKey: 'types.c4_title',
        titleDefault: 'Fiestas Privadas',
        descKey: 'types.c4_desc',
        descDefault: 'Eleva cumpleaños, aniversarios y veladas exclusivas con barras móviles privadas, ambientación de lujo y total tranquilidad para el anfitrión.',
        media: "{{ 'event-real-fiestas.jpg' | asset_url }}",
        formValue: 'Fiesta Privada'
      }
    ];

    // --- GLOBAL STATE ---
    let currentSlideIndex = 0;
    let isTransitioning = false;
    let shaderMaterial, renderer, scene, camera;
    let slideTextures = [];
    let texturesLoaded = false;
    let autoSlideTimer = null;
    let progressAnimation = null;
    let sliderEnabled = false;

    const SLIDE_DURATION = () => SLIDER_CONFIG.settings.autoSlideSpeed;
    const PROGRESS_UPDATE_INTERVAL = 50;
    const TRANSITION_DURATION = () => SLIDER_CONFIG.settings.transitionDuration;

    // Helper: i18n lookup
    const getI18n = (key, fallback) => {
      if (window.LuckyShakerLang && typeof window.LuckyShakerLang.get === 'function') {
        const val = window.LuckyShakerLang.get(key);
        if (val && val !== key) return val;
      }
      return fallback;
    };

    // --- SHADERS ---
    const vertexShader = `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `;

    const fragmentShader = `
      uniform sampler2D uTexture1, uTexture2;
      uniform float uProgress;
      uniform vec2 uResolution, uTexture1Size, uTexture2Size;
      uniform float uGlobalIntensity, uSpeedMultiplier, uDistortionStrength;
      uniform float uGlassRefractionStrength, uGlassChromaticAberration, uGlassBubbleClarity, uGlassEdgeGlow, uGlassLiquidFlow;
      varying vec2 vUv;

      vec2 getCoverUV(vec2 uv, vec2 textureSize) {
        vec2 s = uResolution / textureSize;
        float scale = max(s.x, s.y);
        vec2 scaledSize = textureSize * scale;
        vec2 offset = (uResolution - scaledSize) * 0.5;
        return (uv * uResolution - offset) / scaledSize;
      }

      vec4 glassEffect(vec2 uv, float progress) {
        float time = progress * 5.0 * uSpeedMultiplier;
        vec2 uv1 = getCoverUV(uv, uTexture1Size);
        vec2 uv2 = getCoverUV(uv, uTexture2Size);
        float maxR = length(uResolution) * 0.85;
        float br = progress * maxR;
        vec2 p = uv * uResolution;
        vec2 c = uResolution * 0.5;
        float d = length(p - c);
        float nd = d / max(br, 0.001);
        float param = smoothstep(br + 3.0, br - 3.0, d);
        vec4 img;
        if (param > 0.0) {
          float ro = 0.08 * uGlassRefractionStrength * uDistortionStrength * uGlobalIntensity * pow(smoothstep(0.3 * uGlassBubbleClarity, 1.0, nd), 1.5);
          vec2 dir = (d > 0.0) ? (p - c) / d : vec2(0.0);
          vec2 distUV = uv2 - dir * ro;
          distUV += vec2(sin(time + nd * 10.0), cos(time * 0.8 + nd * 8.0)) * 0.015 * uGlassLiquidFlow * uSpeedMultiplier * nd * param;
          float ca = 0.02 * uGlassChromaticAberration * uGlobalIntensity * pow(smoothstep(0.3, 1.0, nd), 1.2);
          img = vec4(
            texture2D(uTexture2, distUV + dir * ca * 1.2).r,
            texture2D(uTexture2, distUV + dir * ca * 0.2).g,
            texture2D(uTexture2, distUV - dir * ca * 0.8).b,
            1.0
          );
          if (uGlassEdgeGlow > 0.0) {
            float rim = smoothstep(0.95, 1.0, nd) * (1.0 - smoothstep(1.0, 1.01, nd));
            img.rgb += rim * 0.08 * uGlassEdgeGlow * uGlobalIntensity;
          }
        } else {
          img = texture2D(uTexture2, uv2);
        }
        vec4 oldImg = texture2D(uTexture1, uv1);
        if (progress > 0.95) img = mix(img, texture2D(uTexture2, uv2), (progress - 0.95) / 0.05);
        return mix(oldImg, img, param);
      }

      void main() {
        gl_FragColor = glassEffect(vUv, uProgress);
      }
    `;

    // --- CHARACTER SPLITTING ---
    const splitText = (text) => {
      return text.split('').map(char => `<span style="display: inline-block; opacity: 0;">${char === ' ' ? '&nbsp;' : char}</span>`).join('');
    };

    // --- UPDATE CONTENT WITH GSAP ---
    const updateContent = (idx) => {
      const titleEl = document.getElementById('mainTitle');
      const descEl = document.getElementById('mainDesc');
      if (titleEl && descEl && window.gsap) {
        // Universal animate out (fade up)
        gsap.to(titleEl.children, { y: -20, opacity: 0, duration: 0.5, stagger: 0.02, ease: "power2.in" });
        gsap.to(descEl, { y: -10, opacity: 0, duration: 0.4, ease: "power2.in" });

        setTimeout(() => {
          const slide = slides[idx];
          titleEl.innerHTML = splitText(getI18n(slide.titleKey, slide.titleDefault));
          descEl.textContent = getI18n(slide.descKey, slide.descDefault);

          gsap.set(titleEl.children, { opacity: 0 });
          gsap.set(descEl, { y: 20, opacity: 0 });

          const children = titleEl.children;
          switch (idx) {
            case 0: // Bodas: Stagger Up
              gsap.set(children, { y: 20 });
              gsap.to(children, { y: 0, opacity: 1, duration: 0.8, stagger: 0.03, ease: "power3.out" });
              gsap.to(descEl, { y: 0, opacity: 1, duration: 0.8, delay: 0.2, ease: "power3.out" });
              break;
            case 1: // Gender Reveal: Stagger Down
              gsap.set(children, { y: -20 });
              gsap.to(children, { y: 0, opacity: 1, duration: 0.8, stagger: 0.03, ease: "back.out(1.7)" });
              gsap.to(descEl, { y: 0, opacity: 1, duration: 0.8, delay: 0.2, ease: "power3.out" });
              break;
            case 2: // Evento de Negocios: Blur Reveal
              gsap.set(children, { filter: "blur(10px)", scale: 1.5, y: 0 });
              gsap.to(children, { filter: "blur(0px)", scale: 1, opacity: 1, duration: 1, stagger: { amount: 0.5, from: "random" }, ease: "power2.out" });
              gsap.to(descEl, { y: 0, opacity: 1, duration: 1, delay: 0.3, ease: "power2.out" });
              break;
            case 3: // Fiestas: Scale In
              gsap.set(children, { scale: 0, y: 0 });
              gsap.to(children, { scale: 1, opacity: 1, duration: 0.6, stagger: 0.05, ease: "back.out(1.5)" });
              gsap.to(descEl, { y: 0, opacity: 1, duration: 0.8, delay: 0.2, ease: "power3.out" });
              break;
            default:
              gsap.set(children, { y: 20 });
              gsap.to(children, { y: 0, opacity: 1, duration: 0.8, stagger: 0.03, ease: "power3.out" });
              gsap.to(descEl, { y: 0, opacity: 1, duration: 0.8, delay: 0.2, ease: "power3.out" });
          }
        }, 500);
      }
    };

    // --- SLIDE NAVIGATION ---
    const navigateToSlide = (targetIndex) => {
      if (isTransitioning || targetIndex === currentSlideIndex) return;
      stopAutoSlideTimer();
      quickResetProgress(currentSlideIndex);

      const currentTexture = slideTextures[currentSlideIndex];
      const targetTexture = slideTextures[targetIndex];
      if (!currentTexture || !targetTexture || !shaderMaterial) return;

      isTransitioning = true;
      shaderMaterial.uniforms.uTexture1.value = currentTexture;
      shaderMaterial.uniforms.uTexture2.value = targetTexture;
      shaderMaterial.uniforms.uTexture1Size.value = currentTexture.userData.size;
      shaderMaterial.uniforms.uTexture2Size.value = targetTexture.userData.size;

      updateContent(targetIndex);

      currentSlideIndex = targetIndex;
      updateCounter(currentSlideIndex);
      updateNavigationState(currentSlideIndex);

      if (window.gsap) {
        gsap.fromTo(shaderMaterial.uniforms.uProgress,
          { value: 0 },
          {
            value: 1,
            duration: TRANSITION_DURATION(),
            ease: "power2.inOut",
            onComplete: () => {
              shaderMaterial.uniforms.uProgress.value = 0;
              shaderMaterial.uniforms.uTexture1.value = targetTexture;
              shaderMaterial.uniforms.uTexture1Size.value = targetTexture.userData.size;
              isTransitioning = false;
              safeStartTimer(100);
            }
          }
        );
      } else {
        shaderMaterial.uniforms.uProgress.value = 0;
        shaderMaterial.uniforms.uTexture1.value = targetTexture;
        isTransitioning = false;
        safeStartTimer(100);
      }
    };

    const handleSlideChange = () => {
      if (isTransitioning || !texturesLoaded || !sliderEnabled) return;
      navigateToSlide((currentSlideIndex + 1) % slides.length);
    };

    // --- CREATE 4 CATEGORY NAV ITEMS ---
    const createSlidesNavigation = () => {
      const nav = document.getElementById("slidesNav");
      if (!nav) return;
      nav.innerHTML = "";
      slides.forEach((slide, i) => {
        const item = document.createElement("div");
        item.className = `slide-nav-item${i === 0 ? " active" : ""}`;
        item.dataset.slideIndex = String(i);
        const catLabel = getI18n(slide.categoryKey, slide.categoryDefault);
        item.innerHTML = `
          <div class="slide-progress-line"><div class="slide-progress-fill"></div></div>
          <div class="slide-nav-title">${catLabel}</div>
        `;
        item.addEventListener("click", (e) => {
          e.stopPropagation();
          if (!isTransitioning && i !== currentSlideIndex) {
            stopAutoSlideTimer();
            quickResetProgress(currentSlideIndex);
            navigateToSlide(i);
          }
        });
        nav.appendChild(item);
      });
    };

    const updateNavigationState = (idx) => {
      document.querySelectorAll(".slide-nav-item").forEach((el, i) => {
        el.classList.toggle("active", i === idx);
      });
    };

    const updateSlideProgress = (idx, prog) => {
      const el = document.querySelectorAll(".slide-nav-item")[idx]?.querySelector(".slide-progress-fill");
      if (el) {
        el.style.width = `${prog}%`;
        el.style.opacity = '1';
      }
    };

    const fadeSlideProgress = (idx) => {
      const el = document.querySelectorAll(".slide-nav-item")[idx]?.querySelector(".slide-progress-fill");
      if (el) {
        el.style.opacity = '0';
        setTimeout(() => { if (el) el.style.width = "0%"; }, 300);
      }
    };

    const quickResetProgress = (idx) => {
      const el = document.querySelectorAll(".slide-nav-item")[idx]?.querySelector(".slide-progress-fill");
      if (el) {
        el.style.transition = "width 0.2s ease-out";
        el.style.width = "0%";
        setTimeout(() => {
          if (el) el.style.transition = "width 0.1s ease, opacity 0.3s ease";
        }, 200);
      }
    };

    const updateCounter = (idx) => {
      const sn = document.getElementById("slideNumber");
      if (sn) sn.textContent = String(idx + 1).padStart(2, "0");
      const st = document.getElementById("slideTotal");
      if (st) st.textContent = String(slides.length).padStart(2, "0");
    };

    const startAutoSlideTimer = () => {
      if (!texturesLoaded || !sliderEnabled) return;
      stopAutoSlideTimer();
      let progress = 0;
      const increment = (100 / SLIDE_DURATION()) * PROGRESS_UPDATE_INTERVAL;
      progressAnimation = setInterval(() => {
        if (!sliderEnabled) { stopAutoSlideTimer(); return; }
        progress += increment;
        updateSlideProgress(currentSlideIndex, progress);
        if (progress >= 100) {
          clearInterval(progressAnimation);
          progressAnimation = null;
          fadeSlideProgress(currentSlideIndex);
          if (!isTransitioning) handleSlideChange();
        }
      }, PROGRESS_UPDATE_INTERVAL);
    };

    const stopAutoSlideTimer = () => {
      if (progressAnimation) clearInterval(progressAnimation);
      if (autoSlideTimer) clearTimeout(autoSlideTimer);
      progressAnimation = null;
      autoSlideTimer = null;
    };

    const safeStartTimer = (delay = 0) => {
      stopAutoSlideTimer();
      if (sliderEnabled && texturesLoaded) {
        if (delay > 0) autoSlideTimer = setTimeout(startAutoSlideTimer, delay);
        else startAutoSlideTimer();
      }
    };

    const loadImageTexture = (src) => new Promise((resolve, reject) => {
      const loader = new THREE.TextureLoader();
      loader.load(
        src,
        (t) => {
          t.minFilter = t.magFilter = THREE.LinearFilter;
          t.userData = { size: new THREE.Vector2(t.image.naturalWidth || t.image.width || 1376, t.image.naturalHeight || t.image.height || 768) };
          resolve(t);
        },
        undefined,
        reject
      );
    });

    const initRenderer = async () => {
      const width = wrapper.clientWidth || window.innerWidth;
      const height = wrapper.clientHeight || 650;

      scene = new THREE.Scene();
      camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
      renderer = new THREE.WebGLRenderer({ canvas, antialias: false, alpha: false });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      shaderMaterial = new THREE.ShaderMaterial({
        uniforms: {
          uTexture1: { value: null },
          uTexture2: { value: null },
          uProgress: { value: 0 },
          uResolution: { value: new THREE.Vector2(width, height) },
          uTexture1Size: { value: new THREE.Vector2(1, 1) },
          uTexture2Size: { value: new THREE.Vector2(1, 1) },
          uGlobalIntensity: { value: 1.0 },
          uSpeedMultiplier: { value: 1.0 },
          uDistortionStrength: { value: 1.0 },
          uGlassRefractionStrength: { value: 1.0 },
          uGlassChromaticAberration: { value: 1.0 },
          uGlassBubbleClarity: { value: 1.0 },
          uGlassEdgeGlow: { value: 1.0 },
          uGlassLiquidFlow: { value: 1.0 }
        },
        vertexShader,
        fragmentShader
      });

      scene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), shaderMaterial));

      for (const s of slides) {
        try {
          slideTextures.push(await loadImageTexture(s.media));
        } catch (e) {
          console.warn("Failed texture:", s.media, e);
        }
      }

      if (slideTextures.length >= 2) {
        shaderMaterial.uniforms.uTexture1.value = slideTextures[0];
        shaderMaterial.uniforms.uTexture2.value = slideTextures[1];
        shaderMaterial.uniforms.uTexture1Size.value = slideTextures[0].userData.size;
        shaderMaterial.uniforms.uTexture2Size.value = slideTextures[1].userData.size;
        texturesLoaded = true;
        sliderEnabled = true;
        wrapper.classList.add("loaded");
        safeStartTimer(500);
      }

      const render = () => {
        requestAnimationFrame(render);
        renderer.render(scene, camera);
      };
      render();
    };

    createSlidesNavigation();
    updateCounter(0);

    // Initial Text Content
    const tEl = document.getElementById('mainTitle');
    const dEl = document.getElementById('mainDesc');
    const contentEl = document.getElementById('slideContent');

    if (tEl && dEl) {
      tEl.innerHTML = splitText(getI18n(slides[0].titleKey, slides[0].titleDefault));
      dEl.textContent = getI18n(slides[0].descKey, slides[0].descDefault);
      if (window.gsap) {
        gsap.fromTo(tEl.children, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 1, stagger: 0.03, ease: "power3.out", delay: 0.5 });
        gsap.fromTo(dEl, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 1, ease: "power3.out", delay: 0.8 });
      }
    }

    // Click on slide content smooth scrolls to booking form
    if (contentEl) {
      contentEl.addEventListener('click', () => {
        const formSection = document.getElementById('book-event');
        if (formSection) {
          formSection.scrollIntoView({ behavior: 'smooth' });
          const sel = document.getElementById('inquiry-event-type');
          if (sel) sel.value = slides[currentSlideIndex].formValue;
        }
      });
      contentEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          contentEl.click();
        }
      });
    }

    await initRenderer();

    // Listeners
    document.addEventListener("visibilitychange", () => document.hidden ? stopAutoSlideTimer() : (!isTransitioning && safeStartTimer()));
    
    window.addEventListener("resize", () => {
      if (renderer && shaderMaterial) {
        const w = wrapper.clientWidth || window.innerWidth;
        const h = wrapper.clientHeight || 650;
        renderer.setSize(w, h);
        shaderMaterial.uniforms.uResolution.value.set(w, h);
      }
    });

    // Language change listener
    document.addEventListener('luckyshaker:langchange', () => {
      const slide = slides[currentSlideIndex];
      if (tEl && dEl && slide) {
        tEl.innerHTML = splitText(getI18n(slide.titleKey, slide.titleDefault));
        dEl.textContent = getI18n(slide.descKey, slide.descDefault);
        if (window.gsap) {
          gsap.set(tEl.children, { opacity: 1, y: 0 });
          gsap.set(dEl, { opacity: 1, y: 0 });
        }
      }
      slides.forEach((s, i) => {
        const titleEl = document.querySelectorAll(".slide-nav-item")[i]?.querySelector(".slide-nav-title");
        if (titleEl) titleEl.textContent = getI18n(s.categoryKey, s.categoryDefault);
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLuminaSlider);
  } else {
    initLuminaSlider();
  }
})();
</script>

