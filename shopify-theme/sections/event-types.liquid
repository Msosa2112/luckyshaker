</style>

<script>
(function() {
  // --- DYNAMIC SCRIPT LOADER ---
  const loadScript = (src, globalName) => new Promise((res, rej) => {
    if (window[globalName]) { res(); return; }
    if (document.querySelector(`script[src="${src}"]`)) {
      const check = setInterval(() => {
        if (window[globalName]) { clearInterval(check); res(); }
      }, 50);
      setTimeout(() => { clearInterval(check); rej(new Error(`Timeout waiting for ${globalName}`)); }, 10000);
      return;
    }
    const s = document.createElement('script');
    s.src = src;
    s.onload = () => { setTimeout(() => res(), 50); };
    s.onerror = () => rej(new Error(`Failed to load ${src}`));
    document.head.appendChild(s);
  });

  const initLuminaSlider = async () => {
    try {
      if (!window.gsap) {
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js', 'gsap');
      }
      if (!window.THREE) {
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js', 'THREE');
      }
    } catch (e) {
      console.error('Failed to load base scripts:', e);
    }

    const wrapper = document.getElementById('luminaSliderWrapper');
    const canvas = document.getElementById('luminaCanvas');
    if (!wrapper || !canvas || !window.THREE) return;

    // --- CONFIGURATION ---
    const SLIDER_CONFIG = {
      settings: {
        transitionDuration: parseFloat(wrapper.dataset.transitionDuration) || 2.5,
        autoSlideSpeed: parseInt(wrapper.dataset.autoSlide, 10) || 5000,
        currentEffect: "glass",
        currentEffectPreset: "Default",
        globalIntensity: 1.0,
        speedMultiplier: 1.0,
        distortionStrength: 1.0,
        colorEnhancement: 1.0,
        glassRefractionStrength: 1.0,
        glassChromaticAberration: 1.0,
        glassBubbleClarity: 1.0,
        glassEdgeGlow: 1.0,
        glassLiquidFlow: 1.0
      }
    };

    // Helper: i18n lookup
    const getI18n = (key, fallback) => {
      if (window.LuckyShakerLang && typeof window.LuckyShakerLang.get === 'function') {
        const val = window.LuckyShakerLang.get(key);
        if (val && val !== key) return val;
      }
      return fallback;
    };

    // --- 4 CATEGORIES & EXTENDED REAL PHOTO GALLERIES ---
    const slides = [
      {
        id: 'bodas',
        categoryKey: 'types.cat_1',
        categoryDefault: 'Bodas',
        titleKey: 'types.c1_title',
        titleDefault: 'Bodas & Recepción',
