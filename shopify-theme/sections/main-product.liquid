<section class="pdp-main-section" data-section-id="{{ section.id }}">
  <div class="pdp-breadcrumbs-wrap">
    <nav class="page-breadcrumbs" aria-label="Navegación secundaria">
      <a href="{{ routes.root_url }}" data-i18n="pdp.crumb_home">Inicio</a>
      <span class="crumb-sep">/</span>
      <a href="{{ routes.all_products_collection_url }}" data-i18n="pdp.crumb_collection">Colección Reserva</a>
      <span class="crumb-sep">/</span>
      <span class="crumb-current">{{ product.title }}</span>
    </nav>
  </div>

  <div class="pdp-grid">
    <!-- LEFT: STICKY PRODUCT GALLERY -->
    <div class="pdp-gallery-wrap">
      <div class="pdp-main-image-box">
        <span class="pdp-bestseller-badge" data-i18n="pdp.reserve_badge">BOTELLA RESERVA</span>
        
        {%- assign abv_display = '18% ABV' -%}
        {%- if product.description contains 'ABV:' -%}
          {%- assign abv_raw = product.description | split: 'ABV:' | last | split: '</li>' | first | split: '</p>' | first | strip_html | strip -%}
          {%- if abv_raw != blank -%}
            {%- assign abv_display = abv_raw | replace: 'Alc / Vol', 'ABV' | replace: 'Alc/Vol', 'ABV' -%}
          {%- endif -%}
        {%- elsif product.metafields.custom.abv != blank -%}
          {%- assign abv_display = product.metafields.custom.abv -%}
        {%- endif -%}
        <span class="pdp-abv-badge">{{ abv_display }} &bull; 750 ML</span>

        {%- if product.featured_image -%}
          <img id="pdp-active-img" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title }}" class="pdp-main-image" width="600" height="600">
        {%- elsif product.handle == 'whiskey-cream' -%}
          <img id="pdp-active-img" src="{{ 'prod-whiskey-cream.png' | asset_url }}" alt="{{ product.title }}" class="pdp-main-image" width="600" height="600">
        {%- else -%}
          {%- assign fallback_img = 'prod-' | append: product.handle | append: '.jpg' -%}
          <img id="pdp-active-img" src="{{ fallback_img | asset_url }}" alt="{{ product.title }}" class="pdp-main-image" width="600" height="600" onerror="this.onerror=null; this.src='{{ 'margarita.jpg' | asset_url }}';">
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="pdp-thumbnails">
          {%- for image in product.images -%}
            <button type="button" class="pdp-thumb{% if forloop.first %} active{% endif %}" onclick="document.getElementById('pdp-active-img').src='{{ image | image_url: width: 900 }}'; document.querySelectorAll('.pdp-thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');" aria-label="Ver foto {{ forloop.index }}">
              <img src="{{ image | image_url: width: 160 }}" alt="{{ product.title }}" width="72" height="72">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- RIGHT: PRODUCT INFO & BUY BOX -->
    <div class="pdp-info-wrap">
      <div class="pdp-header-block">
        <span class="pdp-eyebrow" data-i18n="pdp.eyebrow">RESERVA PRIVADA // LOTE DE MIXÓLOGO MAESTRO</span>
        <h1 class="pdp-title">{{ product.title }}</h1>
        <div class="pdp-subtitle" data-i18n="pdp.subtitle">Formulado por Katherin &bull; Cóctel de Autor Listo para Servir</div>
      </div>

      <div class="pdp-rating-row">
        <div class="pdp-stars">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#E82B7D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#E82B7D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#E82B7D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#E82B7D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#E82B7D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <span class="pdp-rating-score">4.95 / 5.0</span>
        <span class="pdp-rating-count" data-i18n="pdp.reviews_count">(+180 Reseñas Verificadas)</span>
      </div>

      <div class="pdp-price-block">
        <div class="pdp-price-main">
          <span id="pdp-price-display" class="pdp-price">{{ product.selected_or_first_available_variant.price | money }}</span>
          {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
            <span class="pdp-compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
        <div class="pdp-shipping-badge">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span data-i18n="pdp.free_shipping">Envío Express Gratis +21 en órdenes de $80+</span>
        </div>
      </div>

      <!-- Clean Narrative Description -->
      <div class="pdp-description-content">
        {{ product.description | default: '<p>Elaborado a mano con licores artesanales, botánicos frescos y cero conservantes artificiales. Perfectamente equilibrado para disfrutar de inmediato sobre hielo cristalino.</p>' }}
      </div>

      <!-- Dynamic Product Form -->
      {%- form 'product', product, id: 'pdp-product-form', class: 'pdp-form-wrap' -%}
        <input type="hidden" name="id" id="selected-variant-id" value="{{ product.selected_or_first_available_variant.id }}">

        {%- if product.variants.size > 1 -%}
          <div class="pdp-variants-section">
            <div class="pdp-variant-label">
              <span data-i18n="pdp.select_format">SELECCIONAR PRESENTACIÓN:</span>
              <span id="selected-variant-name" class="variant-active-name">{{ product.selected_or_first_available_variant.title }}</span>
            </div>
            <div class="variant-options-grid">
              {%- for variant in product.variants -%}
                <div class="variant-option-card{% if forloop.first %} active{% endif %}" onclick="LuckyShakerPDP.selectVariant({{ variant.id }}, '{{ variant.price | money }}', this)">
                  <div class="variant-card-title">{{ variant.title }}</div>
                  <div class="variant-card-subtitle">{{ variant.price | money }}</div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Tactile Liquid Stepper + Add to Bag Bar -->
        <div class="pdp-action-row">
          <div class="pdp-qty-pill">
            <button type="button" class="pdp-qty-btn minus" onclick="LuckyShakerPDP.adjustQty(-1)" aria-label="Disminuir cantidad">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <input type="number" id="pdp-qty-input" name="quantity" value="1" min="1" max="12" readonly class="pdp-qty-val">
            <button type="button" class="pdp-qty-btn plus" onclick="LuckyShakerPDP.adjustQty(1)" aria-label="Aumentar cantidad">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
          </div>

          <button type="submit" id="pdp-submit-btn" class="pdp-cta-add">
            <span id="pdp-btn-label" data-i18n="pdp.add_to_bag">AGREGAR A LA BOLSA &bull; {{ product.selected_or_first_available_variant.price | money }}</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </button>
        </div>
      {%- endform -%}

      <!-- 21+ Delivery Guarantee & Trust Badges -->
      <div class="pdp-trust-card">
        <div class="pdp-trust-row">
          <div class="trust-icon-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E82B7D" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <span data-i18n="pdp.trust_pkg">Empaque Térmico con Garantía Total contra Roturas</span>
        </div>
        <div class="pdp-trust-divider"></div>
        <div class="pdp-trust-row">
          <div class="trust-icon-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E82B7D" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <span data-i18n="pdp.trust_id">Verificación de Firma de Adulto +21 Obligatoria en la Entrega</span>
        </div>
      </div>

      <!-- Luxury Accordions -->
      <div class="pdp-accordions">
        <details class="pdp-accordion-item" open>
          <summary class="pdp-accordion-header">
            <span data-i18n="pdp.tab1_title">PERFIL DE CATA &amp; NOTAS DE PALADAR</span>
            <span class="accordion-chevron">&plus;</span>
          </summary>
          <div class="pdp-accordion-body">
            <p><strong data-i18n="pdp.aroma_label">Aroma:</strong> <span data-i18n="pdp.aroma_val">Infusión botánica aromática fresca, matices de roble añejo y cítricos brillantes.</span></p>
            <p style="margin-top: 0.5rem;"><strong data-i18n="pdp.palate_label">Paladar:</strong> <span data-i18n="pdp.palate_val">Textura sedosa y envolvente con profundidad de destilado artesanal, equilibrada por caña de azúcar pura y cítricos prensados en frío.</span></p>
            <p style="margin-top: 0.5rem;"><strong data-i18n="pdp.finish_label">Final:</strong> <span data-i18n="pdp.finish_val">Excepcionalmente suave, final prolongado de coctelería de autor con sensación limpia y fresca.</span></p>
          </div>
        </details>

        <details class="pdp-accordion-item">
          <summary class="pdp-accordion-header">
            <span data-i18n="pdp.tab2_title">EL RITUAL DE SERVIDO</span>
            <span class="accordion-chevron">&plus;</span>
          </summary>
          <div class="pdp-accordion-body">
            <p data-i18n="pdp.ritual_1">1. Enfría la botella a 4&deg;C antes de servir.</p>
            <p style="margin-top: 0.4rem;" data-i18n="pdp.ritual_2">2. Agita enérgicamente 3 veces para emulsionar todos los aceites botánicos naturales.</p>
            <p style="margin-top: 0.4rem;" data-i18n="pdp.ritual_3">3. Vierte 3.5oz a 4.0oz sobre una esfera de hielo cristalino o rocas.</p>
            <p style="margin-top: 0.4rem;" data-i18n="pdp.ritual_4">4. Decora con un twist fresco de piel de cítrico y disfruta.</p>
          </div>
        </details>

        <details class="pdp-accordion-item">
          <summary class="pdp-accordion-header">
            <span data-i18n="pdp.tab3_title">CONSERVACIÓN, VIDA ÚTIL &amp; ALÉRGENOS</span>
            <span class="accordion-chevron">&plus;</span>
          </summary>
          <div class="pdp-accordion-body">
            <p><strong data-i18n="pdp.shelf_label">Vida Útil:</strong> <span data-i18n="pdp.shelf_val">12 meses sin abrir a temperatura ambiente lejos del sol directo. Una vez abierta, refrigerar y consumir dentro de los 6 meses.</span></p>
            <p style="margin-top: 0.4rem;"><strong data-i18n="pdp.volume_label">Volumen:</strong> <span data-i18n="pdp.volume_val">Botella de vidrio de 750 ML (Rinde 6 a 8 copas completas de alta coctelería).</span></p>
            <p style="margin-top: 0.4rem;"><strong data-i18n="pdp.formulation_label">Formulación:</strong> <span data-i18n="pdp.formulation_val">Ingredientes 100% libres de gluten, destilados premium naturales, sin conservantes químicos sintéticos.</span></p>
          </div>
        </details>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Información del Producto",
  "settings": []
}
{% endschema %}
