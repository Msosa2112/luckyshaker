<section class="page-hero">
  <div class="page-breadcrumbs">
    <a href="{{ routes.root_url }}">Home</a>
    <span>/</span>
    <span>Contact Concierge</span>
  </div>
  <h1 class="page-title">{{ section.settings.title | default: 'CONCIERGE &amp; CLIENT SERVICES' }}</h1>
  <p class="page-subtitle">
    {{ section.settings.subtitle | default: 'Whether curating custom cocktail pairings for a private celebration, tracking an adult-signature shipment, or discussing hospitality wholesale distribution, our team is at your service.' }}
  </p>
</section>

<main class="contact-page-container">
  <div class="contact-grid-layout">
    
    <!-- Left: Channels -->
    <div class="contact-channels-card">
      <h2 class="contact-card-title">DIRECT CHANNELS</h2>
      <p class="contact-intro">Our concierge desk operates Monday through Saturday, 9:00 AM – 7:00 PM EST.</p>

      <div class="channel-item">
        <span class="channel-icon" style="color: var(--accent-pink); display: flex; align-items: center;">
          {% render 'icon', name: 'map-pin', size: 20, stroke_width: 1.8 %}
        </span>
        <div>
          <h4>Headquarters &amp; Tasting Lab</h4>
          <p>Lucky Shaker Bartender LLC<br>Miami, FL &bull; United States</p>
        </div>
      </div>
    </div>

    <!-- Right: Shopify Form -->
    <div class="contact-form-card">
      <h2 class="contact-card-title">SEND AN INQUIRY</h2>
      <p class="contact-intro">Fill out the brief form below and our lead sommelier will respond within 4 business hours.</p>

      {%- form 'contact', id: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div style="background: rgba(16, 185, 129, 0.12); border: 1px solid #10B981; border-radius: 12px; padding: 1rem; color: #10B981; margin-bottom: 1.5rem;">
            Thank you for reaching out. A Lucky Shaker concierge specialist has received your inquiry.
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div style="background: rgba(239, 68, 68, 0.12); border: 1px solid #EF4444; border-radius: 12px; padding: 1rem; color: #EF4444; margin-bottom: 1.5rem;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-row-2">
          <div class="form-field">
            <label for="ContactFormName">FULL NAME *</label>
            <input type="text" id="ContactFormName" name="contact[name]" required placeholder="Alexander Vance" value="{% if form.name %}{{ form.name }}{% endif %}">
          </div>
          <div class="form-field">
            <label for="ContactFormEmail">EMAIL ADDRESS *</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" required placeholder="alexander@example.com" value="{% if form.email %}{{ form.email }}{% endif %}">
          </div>
        </div>

        <div class="form-field">
          <label for="ContactFormSubject">INQUIRY TYPE</label>
          <select id="ContactFormSubject" name="contact[inquiry_type]" class="form-select">
            <option value="Order & Shipping Status">Order Tracking &amp; Delivery</option>
            <option value="Private Tasting & Events">Private Tasting &amp; VIP Events</option>
            <option value="Corporate Gifting">Corporate Gifting (20+ bottles)</option>
            <option value="Wholesale Distribution">Wholesale &amp; On-Premise Distribution</option>
            <option value="General Mixology Question">General Inquiries</option>
          </select>
        </div>

        <div class="form-field">
          <label for="ContactFormMessage">YOUR MESSAGE *</label>
          <textarea id="ContactFormMessage" name="contact[body]" rows="5" required placeholder="Tell us how we can assist you with your cocktail order or event...">{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <button type="submit" class="btn btn-pink" style="width: 100%; justify-content: center; margin-top: 1rem;">
          <span>TRANSMIT INQUIRY</span>
          {% render 'icon', name: 'arrow-right', size: 14, class: 'btn-arrow', stroke_width: 1.8 %}
        </button>
      {%- endform -%}
    </div>

  </div>
</main>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Hero Title",
      "default": "CONCIERGE & CLIENT SERVICES"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Hero Subtitle",
      "default": "Whether curating custom cocktail pairings for a private celebration, tracking an adult-signature shipment, or discussing hospitality wholesale distribution, our team is at your service."
    }
  ]
}
{% endschema %}
