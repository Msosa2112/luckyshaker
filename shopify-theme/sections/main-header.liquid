<div class="announcement-bar-gwp">
  <span>🎁 <strong>PROMO EXCLUSIVA:</strong> ¡Lleva <strong>1 Crema de Whiskey 100ml GRATIS</strong> comprando cualquier combinación de 2 o más productos! &bull; Envío Express Gratis $80+</span>
</div>
<header class="navbar" id="main-nav" data-section-id="{{ section.id }}">
  <a href="{{ routes.root_url }}" class="nav-brand" aria-label="{{ shop.name }} Home">
    <img src="{{ 'logo_lucky_shaker_light.svg' | asset_url }}" alt="{{ shop.name }}" class="nav-logo-img nav-logo-light" width="160" height="42">
    <img src="{{ 'logo_lucky_shaker_dark.svg' | asset_url }}" alt="{{ shop.name }}" class="nav-logo-img nav-logo-dark" width="160" height="42">
  </a>

  <nav class="nav-center" aria-label="Navegación Principal">
    <ul class="nav-menu">
      {%- if section.settings.menu != blank and section.settings.menu != 'main-menu' and linklists[section.settings.menu].links.size > 0 -%}
        {%- for link in linklists[section.settings.menu].links -%}
          <li>
            <a href="{{ link.url }}" class="nav-link{% if link.current %} active{% endif %}">
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        <li><a href="#events" onclick="const e=document.getElementById('events') || document.getElementById('event-types'); if(e){ e.scrollIntoView({behavior:'smooth'}); return false; }" class="nav-link" data-i18n="nav.events">Eventos &amp; Servicios</a></li>
        <li><a href="#experience" onclick="const ex=document.getElementById('experience') || document.getElementById('event-experience'); if(ex){ ex.scrollIntoView({behavior:'smooth'}); return false; }" class="nav-link" data-i18n="nav.experience">Experiencia</a></li>
        <li><a href="#gallery" onclick="const g=document.getElementById('gallery') || document.getElementById('event-gallery'); if(g){ g.scrollIntoView({behavior:'smooth'}); return false; }" class="nav-link" data-i18n="nav.gallery">Galería</a></li>
        <li><a href="{{ routes.all_products_collection_url }}" class="nav-link nav-shop-link" data-i18n="nav.shop">Tienda Online</a></li>
        <li><a href="#faq" onclick="const f=document.getElementById('faq') || document.getElementById('event-faq'); if(f){ f.scrollIntoView({behavior:'smooth'}); return false; }" class="nav-link" data-i18n="nav.faq">Preguntas</a></li>
      {%- endif -%}
    </ul>
  </nav>

  <div class="nav-actions">
    <!-- Luxury Language Switcher [ ES | EN ] -->
    <div class="lang-switcher" id="lang-switcher" aria-label="Selector de Idioma / Language">
      <button type="button" class="lang-btn active" id="lang-btn-es" data-lang="es" onclick="LuckyShakerLang.setLang('es')">ES</button>
      <span class="lang-divider">/</span>
      <button type="button" class="lang-btn" id="lang-btn-en" data-lang="en" onclick="LuckyShakerLang.setLang('en')">EN</button>
    </div>

    <a href="#book-event" class="btn btn-pink nav-book-btn" onclick="const b=document.getElementById('book-event'); if(b){ b.scrollIntoView({behavior:'smooth'}); return false; }">
      <span data-i18n="nav.book_event">COTIZAR EVENTO</span>
    </a>

    <!-- Luxury Shopping Bag Icon Trigger -->
    <button class="cart-toggle-btn open-cart-btn" aria-label="Ver Bolsa de Compras" id="nav-cart-trigger">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="nav-cart-icon">
        <path d="M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span class="cart-badge" id="cart-badge-count">{{ cart.item_count }}</span>
    </button>

    <!-- Mobile Hamburger Toggle Button -->
    <button type="button" class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Abrir Menú de Navegación" aria-expanded="false">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-backdrop" id="mobile-nav-backdrop"></div>
<aside class="mobile-nav-drawer" id="mobile-nav-drawer" aria-label="Menú Móvil">
  <div class="mobile-nav-header">
    <a href="{{ routes.root_url }}" class="mobile-nav-brand">
      <img src="{{ 'logo_lucky_shaker_dark.svg' | asset_url }}" alt="{{ shop.name }}" width="135" height="34">
    </a>
    <button type="button" class="mobile-nav-close" id="mobile-nav-close" aria-label="Cerrar Menú">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="mobile-nav-body">
    <ul class="mobile-nav-links">
      <li><a href="#events" onclick="const e=document.getElementById('events') || document.getElementById('event-types'); if(e){ e.scrollIntoView({behavior:'smooth'}); return false; }" class="mobile-nav-link" data-i18n="nav.events">EVENTOS &amp; SERVICIOS</a></li>
      <li><a href="{{ routes.all_products_collection_url }}" class="mobile-nav-link" data-i18n="nav.shop">TIENDA ONLINE</a></li>
      <li><a href="#experience" onclick="const ex=document.getElementById('experience') || document.getElementById('event-experience'); if(ex){ ex.scrollIntoView({behavior:'smooth'}); return false; }" class="mobile-nav-link" data-i18n="nav.experience">NOSOTROS &amp; EXPERIENCIA</a></li>
      <li><a href="#gallery" onclick="const g=document.getElementById('gallery') || document.getElementById('event-gallery'); if(g){ g.scrollIntoView({behavior:'smooth'}); return false; }" class="mobile-nav-link" data-i18n="nav.gallery">GALERÍA</a></li>
      <li><a href="#faq" onclick="const f=document.getElementById('faq') || document.getElementById('event-faq'); if(f){ f.scrollIntoView({behavior:'smooth'}); return false; }" class="mobile-nav-link" data-i18n="nav.faq">PREGUNTAS</a></li>
    </ul>
    <div class="mobile-nav-footer">
      <a href="#book-event" class="btn btn-pink mobile-nav-cta" onclick="const b=document.getElementById('book-event'); if(b){ b.scrollIntoView({behavior:'smooth'}); return false; }">
        <span data-i18n="nav.book_event">COTIZAR EVENTO</span>
      </a>
    </div>
  </div>
</aside>

{% schema %}
{
  "name": "Encabezado / Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de Navegación",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
