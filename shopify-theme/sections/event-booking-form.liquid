<section id="book-event" class="event-booking-form-section" data-section-id="{{ section.id }}">
  <div class="event-booking-container">
    <div class="section-header-center">
      <span class="section-eyebrow" data-i18n="booking.eyebrow">{{ section.settings.eyebrow | default: 'RESERVA TU EVENTO' }}</span>
      <h2 class="section-title" data-i18n="booking.headline">{{ section.settings.headline | default: 'Solicita una Cotización Personalizada' }}</h2>
      <p class="section-subtitle" data-i18n="booking.subtitle">
        {{ section.settings.subtitle | default: 'Cuéntanos sobre tu próxima celebración. Nuestro equipo preparará una propuesta de barra a tu medida y confirmará disponibilidad en menos de 24 horas.' }}
      </p>
    </div>

    <div class="booking-form-card">
      {%- form 'contact', id: 'event-quote-form', class: 'event-quote-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="quote-form-success" role="alert">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <div>
              <h4 data-i18n="booking.success_title">¡Muchas gracias! Hemos recibido tu solicitud.</h4>
              <p data-i18n="booking.success_desc">Nuestro director de eventos revisará los detalles y te enviará una propuesta personalizada en menos de 24 horas.</p>
            </div>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="quote-form-error" role="alert">
            <p>{{ form.errors | default_errors }}</p>
          </div>
        {%- endif -%}

        <div class="quote-form-grid">
          <!-- Nombre Completo -->
          <div class="form-group">
            <label for="inquiry-name" class="form-label" data-i18n="booking.lbl_name">Nombre Completo *</label>
            <input type="text" id="inquiry-name" name="contact[name]" class="form-input" placeholder="Ej. Alejandra Valdés" required value="{% if form.name %}{{ form.name }}{% endif %}">
          </div>

          <!-- Correo Electrónico -->
          <div class="form-group">
            <label for="inquiry-email" class="form-label" data-i18n="booking.lbl_email">Correo Electrónico *</label>
            <input type="email" id="inquiry-email" name="contact[email]" class="form-input" placeholder="alejandra@ejemplo.com" required value="{% if form.email %}{{ form.email }}{% endif %}">
          </div>

          <!-- Teléfono -->
          <div class="form-group">
            <label for="inquiry-phone" class="form-label" data-i18n="booking.lbl_phone">Número de Teléfono *</label>
            <input type="tel" id="inquiry-phone" name="contact[phone]" class="form-input" placeholder="(305) 555-0192" required value="{% if form.phone %}{{ form.phone }}{% endif %}">
          </div>

          <!-- Tipo de Evento -->
          <div class="form-group">
            <label for="inquiry-event-type" class="form-label" data-i18n="booking.lbl_type">Tipo de Evento *</label>
            <select id="inquiry-event-type" name="contact[event_type]" class="form-select" required>
              <option value="" disabled selected data-i18n="booking.opt_select">Selecciona el tipo de evento</option>
              <option value="Boda" data-i18n="booking.opt_wedding">Boda &amp; Recepción</option>
              <option value="Fiesta Privada" data-i18n="booking.opt_private">Fiesta Privada / Cumpleaños</option>
              <option value="Evento Corporativo" data-i18n="booking.opt_corp">Gala Corporativa / Evento de Marca</option>
              <option value="Masterclass" data-i18n="booking.opt_masterclass">Masterclass de Coctelería / Taller</option>
              <option value="Otra Celebración" data-i18n="booking.opt_other">Otra Celebración Especial</option>
            </select>
          </div>

          <!-- Fecha del Evento -->
          <div class="form-group">
            <label for="inquiry-date" class="form-label" data-i18n="booking.lbl_date">Fecha Estimada del Evento *</label>
            <input type="date" id="inquiry-date" name="contact[event_date]" class="form-input" required>
          </div>

          <!-- Número de Invitados -->
          <div class="form-group">
            <label for="inquiry-guests" class="form-label" data-i18n="booking.lbl_guests">Número Estimado de Invitados *</label>
            <select id="inquiry-guests" name="contact[guest_count]" class="form-select" required>
              <option value="" disabled selected data-i18n="booking.opt_guest_select">Selecciona el rango de invitados</option>
              <option value="10-25 Invitados" data-i18n="booking.opt_g1">10–25 Invitados (Íntimo)</option>
              <option value="26-50 Invitados" data-i18n="booking.opt_g2">26–50 Invitados (Mediano)</option>
              <option value="51-100 Invitados" data-i18n="booking.opt_g3">51–100 Invitados (Grande)</option>
              <option value="101-200+ Invitados" data-i18n="booking.opt_g4">101–200+ Invitados (Gala / Boda)</option>
            </select>
          </div>

          <!-- Ubicación / Lugar -->
          <div class="form-group full-width">
            <label for="inquiry-location" class="form-label" data-i18n="booking.lbl_location">Ubicación / Ciudad y Lugar del Evento *</label>
            <input type="text" id="inquiry-location" name="contact[location]" class="form-input" placeholder="Ej. Residencia Privada en Coral Gables / Salón Biltmore" required>
          </div>

          <!-- Preferencias y Notas -->
          <div class="form-group full-width">
            <label for="inquiry-message" class="form-label" data-i18n="booking.lbl_notes">Peticiones Especiales / Preferencias de Cócteles</label>
            <textarea id="inquiry-message" name="contact[body]" class="form-textarea" rows="4" placeholder="Cuéntanos sobre tus licores favoritos, temática del evento o ideas especiales de cócteles..."></textarea>
          </div>
        </div>

        <div class="form-submit-row">
          <button type="submit" class="btn btn-pink btn-submit-quote">
            <span data-i18n="booking.btn_submit">ENVIAR SOLICITUD DE COTIZACIÓN</span>
            <svg class="btn-arrow" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12M8 2l5 5-5 5"/></svg>
          </button>
          <div class="form-guarantee-text">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span data-i18n="booking.guarantee">Sin pagos por adelantado &bull; Respuesta personalizada en 24 horas</span>
          </div>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulario de Cotización",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "RESERVA TU EVENTO"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Título Principal",
      "default": "Solicita una Cotización Personalizada"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Cuéntanos sobre tu próxima celebración. Nuestro equipo preparará una propuesta de barra a tu medida y confirmará disponibilidad en menos de 24 horas."
    }
  ],
  "presets": [
    {
      "name": "Formulario de Cotización"
    }
  ]
}
{% endschema %}
