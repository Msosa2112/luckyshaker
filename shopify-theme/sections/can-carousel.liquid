{%- comment -%}
  LUCKY SHAKER — CAN CAROUSEL SHOP
  Cinematic 3D can carousel (centre can sharp + floating, neighbours blurred),
  quick-view pop-up in place, spirit index, and a grid view fallback.

  Needs, per product handle, an asset named  can-<handle>.webp
  (generated by scripts/build_can_assets.py). Products without a can still
  appear in the GRID view through the regular product-card snippet.
{%- endcomment -%}

{{ 'can-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign can_handles = 'margarita,blue-hawaii,caipirinha,classic-martini,cosmopolitan,daiquiri,espresso-martini,gin-tonic,mai-tai,malibu-bay-breeze,manhattan,mimosa,moscow-mule,negroni,old-fashioned,paloma,pina-colada,sex-on-the-beach' | split: ','
  assign cc_bg = ''
  assign cc_cans = ''
  assign cc_infos = ''
  assign cc_spirits_seen = ''
  assign cc_count = 0
-%}

{%- paginate collection.products by 50 -%}

  {%- for product in collection.products -%}
    {%- unless can_handles contains product.handle -%}{%- continue -%}{%- endunless -%}

    {%- liquid
      assign idx = cc_count
      assign cc_count = cc_count | plus: 1
      assign clean_title = product.title | replace: ' 750ml', '' | replace: ' 750ML', '' | replace: ' 750 ml', ''

      case product.handle
        when 'margarita'
          assign spirit = 'tequila'
          assign tint = '#E8D77A'
        when 'paloma'
          assign spirit = 'tequila'
          assign tint = '#FF8E7B'
        when 'daiquiri'
          assign spirit = 'rum'
          assign tint = '#A6D67A'
        when 'caipirinha'
          assign spirit = 'rum'
          assign tint = '#B9D96B'
        when 'mai-tai'
          assign spirit = 'rum'
          assign tint = '#F0A13A'
        when 'pina-colada'
          assign spirit = 'rum'
          assign tint = '#F3E3B5'
        when 'malibu-bay-breeze'
          assign spirit = 'rum'
          assign tint = '#F26B5B'
        when 'blue-hawaii'
          assign spirit = 'rum'
          assign tint = '#2FA8E0'
        when 'gin-tonic'
          assign spirit = 'gin'
          assign tint = '#BFE3D6'
        when 'negroni'
          assign spirit = 'gin'
          assign tint = '#C42B3B'
        when 'classic-martini'
          assign spirit = 'gin'
          assign tint = '#E6DFC2'
        when 'moscow-mule'
          assign spirit = 'vodka'
          assign tint = '#C7D2CC'
        when 'cosmopolitan'
          assign spirit = 'vodka'
          assign tint = '#E04B73'
        when 'sex-on-the-beach'
          assign spirit = 'vodka'
          assign tint = '#FF7A3D'
        when 'espresso-martini'
          assign spirit = 'vodka'
          assign tint = '#7A4A36'
        when 'manhattan'
          assign spirit = 'whiskey'
          assign tint = '#B5532A'
        when 'old-fashioned'
          assign spirit = 'whiskey'
          assign tint = '#B8672E'
        when 'mimosa'
          assign spirit = 'sparkling'
          assign tint = '#FFB93B'
        else
          assign spirit = 'rum'
          assign tint = '#D9DBE3'
      endcase

      unless cc_spirits_seen contains spirit
        assign cc_spirits_seen = cc_spirits_seen | append: spirit | append: ','
      endunless

      assign abv_val = '16% ABV'
      if product.description contains 'ABV:</strong>'
        assign abv_split = product.description | split: 'ABV:</strong> ' | last | split: '</li>' | first | split: '<' | first | strip
        if abv_split != blank
          assign abv_val = abv_split | replace: 'Alc / Vol', 'ABV' | replace: 'Alc/Vol', 'ABV' | replace: 'ALC / VOL', 'ABV' | replace: 'Alc / vol', 'ABV' | replace: 'alc / vol', 'ABV'
        endif
      endif

      assign ing_line = ''
      if product.description contains 'Ingredients:</strong>'
        assign ing_line = product.description | split: 'Ingredients:</strong> ' | last | split: '</li>' | first | split: '<' | first | strip
      endif

      assign ritual_line = ''
      if product.description contains 'Serving Ritual:</strong>'
        assign ritual_line = product.description | split: 'Serving Ritual:</strong> ' | last | split: '</li>' | first | split: '<' | first | strip
      endif

      assign desc_line = ''
      if product.description contains '</p>'
        assign desc_line = product.description | split: '</p>' | first | strip_html | strip
      else
        assign desc_line = product.description | strip_html | truncatewords: 34
      endif

      if product.featured_image
        assign bg_src = product.featured_image | image_url: width: 520
        assign photo_src = product.featured_image | image_url: width: 1100
      else
        assign bg_fallback = 'prod-' | append: product.handle | append: '.jpg'
        assign bg_src = bg_fallback | asset_url
        assign photo_src = bg_src
      endif

      assign can_file = 'can-' | append: product.handle | append: '.webp'
      assign can_src = can_file | asset_url
      assign variant = product.selected_or_first_available_variant
    -%}

    {%- capture bg_piece -%}
      <img class="cc-bg-img" data-i="{{ idx }}" src="{{ bg_src }}" alt="" width="520" height="520" {% if idx > 1 %}loading="lazy"{% endif %} decoding="async">
    {%- endcapture -%}
    {%- assign cc_bg = cc_bg | append: bg_piece -%}

    {%- capture can_piece -%}
      <button type="button" class="cc-can" data-i="{{ idx }}" data-pos="9" tabindex="-1" aria-label="{{ clean_title | escape }}">
        <img class="cc-can-img" src="{{ can_src }}" alt="{{ clean_title | escape }}" width="640" height="1040" draggable="false" {% if idx > 2 %}loading="lazy"{% endif %} decoding="async">
      </button>
    {%- endcapture -%}
    {%- assign cc_cans = cc_cans | append: can_piece -%}

    {%- capture info_piece -%}
      <article class="cc-info" data-i="{{ idx }}" data-handle="{{ product.handle }}" data-spirit="{{ spirit }}" data-tint="{{ tint }}"
        data-variant="{{ variant.id }}" data-available="{{ product.available }}" data-url="{{ product.url }}"
        data-title="{{ clean_title | escape }}" data-price="{{ product.price | money | escape }}"
        data-compare="{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | escape }}{% endif %}"
        data-abv="{{ abv_val | escape }}" data-bg="{{ bg_src }}" data-photo="{{ photo_src }}" data-can="{{ can_src }}" aria-hidden="true">
        <p class="cc-info-kicker"><span data-cc-t="sp_{{ spirit }}">{{ spirit | capitalize }}</span><i aria-hidden="true"></i><span>{{ abv_val }}</span></p>
        <h2 class="cc-info-title"><span>{{ clean_title }}</span></h2>
        <p class="cc-info-sub">{{ ing_line | default: desc_line | replace: ',', ' ·' }}</p>
        <div class="cc-info-cta">
          <span class="cc-price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</span>
          <button type="button" class="cc-more" data-cc-open tabindex="-1">
            <span data-cc-t="more">VER MÁS</span>
            <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5"/></svg>
          </button>
        </div>
        <div class="cc-detail" hidden>
          <p class="cc-detail-desc">{{ desc_line | escape }}</p>
          <ul class="cc-detail-chips">
            {%- assign ing_chips = ing_line | split: ',' -%}
            {%- for chip in ing_chips limit: 6 -%}
              {%- assign chip_clean = chip | strip -%}
              {%- if chip_clean != blank -%}<li>{{ chip_clean }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if ritual_line != blank -%}<p class="cc-detail-ritual">{{ ritual_line | escape }}</p>{%- endif -%}
        </div>
      </article>
    {%- endcapture -%}
    {%- assign cc_infos = cc_infos | append: info_piece -%}
  {%- endfor -%}

  {%- if cc_count > 0 -%}
    {%- assign cc_view = 'carousel' -%}
  {%- else -%}
    {%- assign cc_view = 'grid' -%}
  {%- endif -%}

  <section class="cc" id="can-carousel" data-cc data-view="{{ cc_view }}" data-count="{{ cc_count }}" aria-label="{{ collection.title | default: 'Collection' | escape }}">

    <!-- Colour wash: every product's own photo, blurred, crossfading behind the cans -->
    <div class="cc-bg" aria-hidden="true">{{ cc_bg }}</div>

    <div class="cc-categories-wrap">
      <nav class="cc-categories" aria-label="Product Categories">
        <button type="button" class="cc-cat-tab is-active" data-cat="cocktails">
          <span data-cc-t="cat_cocktails">COCKTAILS</span>
        </button>
        <span class="cc-cat-sep" aria-hidden="true">|</span>
        <button type="button" class="cc-cat-tab" data-cat="dry-fruits">
          <span data-cc-t="cat_dry_fruits">DRY FRUITS</span>
        </button>
        <span class="cc-cat-sep" aria-hidden="true">|</span>
        <button type="button" class="cc-cat-tab" data-cat="creams">
          <span data-cc-t="cat_creams">CREAMS</span>
          <span class="cc-cat-tag" data-cc-t="tag_soon">PRÓXIMAMENTE</span>
        </button>
        <span class="cc-cat-sep" aria-hidden="true">|</span>
        <button type="button" class="cc-cat-tab" data-cat="gift-sets">
          <span data-cc-t="cat_gift_sets">GIFT SETS</span>
          <span class="cc-cat-tag" data-cc-t="tag_soon">PRÓXIMAMENTE</span>
        </button>
      </nav>
    </div>

    <div class="cc-top">
      <h1 class="cc-eyebrow" data-cc-heading>{{ collection.title | default: 'The Signature Collection' }}</h1>
      <div class="cc-tools" role="group" aria-label="Vista">
        <button type="button" class="cc-tool is-on" data-cc-view="carousel" aria-pressed="true" aria-label="Carrusel" data-cc-label="view_carousel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="4" width="8" height="16" rx="3"/><path d="M3.5 8v8M20.5 8v8"/></svg>
        </button>
        <button type="button" class="cc-tool" data-cc-view="grid" aria-pressed="false" aria-label="Cuadrícula" data-cc-label="view_grid">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6"/></svg>
        </button>
      </div>
    </div>

    <div class="cc-carousel" data-cc-carousel>
      <nav class="cc-spirits" aria-label="Spirits">
        {%- assign cc_spirit_order = 'tequila,rum,gin,vodka,whiskey,sparkling' | split: ',' -%}
        {%- for sp in cc_spirit_order -%}
          {%- if cc_spirits_seen contains sp -%}
            <button type="button" class="cc-spirit" data-spirit="{{ sp }}" data-cc-t="sp_{{ sp }}">{{ sp | capitalize }}</button>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <div class="cc-stage" tabindex="0" role="group" aria-roledescription="carousel" aria-label="{{ collection.title | default: 'Collection' | escape }}">
        <div class="cc-floor" aria-hidden="true"></div>
        <!-- Ingredient atmosphere: sprites of each drink's ingredients float behind and in front of the cans -->
        <div class="cc-fx cc-fx--back" data-cc-fx-back aria-hidden="true"></div>
        <div class="cc-track">{{ cc_cans }}</div>
        <div class="cc-fx cc-fx--front" data-cc-fx-front aria-hidden="true"></div>
        <div class="cc-fx-tip" data-cc-fx-tip aria-hidden="true"></div>
        <button type="button" class="cc-arrow cc-arrow--prev" data-cc-prev aria-label="Anterior" data-cc-label="prev">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="cc-arrow cc-arrow--next" data-cc-next aria-label="Siguiente" data-cc-label="next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

      <div class="cc-meta">
        <div class="cc-infos">{{ cc_infos }}</div>
        <div class="cc-counter" aria-hidden="true"><b data-cc-now>01</b><span>/ <em data-cc-total>{{ cc_count }}</em></span></div>
      </div>
      <p class="cc-live" aria-live="polite" data-cc-live></p>
    </div>

    <!-- GRID VIEW: every product of the collection, regular editorial cards -->
    <div class="cc-gridwrap" data-cc-gridwrap>
      <div class="cc-grid products-catalog">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="cc-empty">No cocktails found in this collection.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="cc-pagination">{{ paginate | default_pagination }}</div>
      {%- endif -%}
    </div>

    <!-- Quick-view pop-up (same page, no navigation) -->
    <div class="cc-modal" data-cc-modal hidden>
      <div class="cc-modal-backdrop" data-cc-close></div>
      <div class="cc-modal-panel" role="dialog" aria-modal="true" aria-labelledby="cc-modal-title">
        <button type="button" class="cc-modal-close" data-cc-close aria-label="Cerrar" data-cc-label="close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
        <div class="cc-modal-visual">
          <img class="cc-modal-photo" data-cc-m-photo src="data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA=" alt="" width="1100" height="1100" draggable="false">
        </div>
        <div class="cc-modal-body">
          <p class="cc-m-kicker"><span data-cc-m-spirit></span><i aria-hidden="true"></i><span data-cc-m-abv></span></p>
          <h2 class="cc-m-title" id="cc-modal-title" data-cc-m-title></h2>
          <p class="cc-m-price"><span data-cc-m-price></span> <s data-cc-m-compare></s></p>
          <p class="cc-m-desc" data-cc-m-desc></p>
          <div class="cc-m-block">
            <h3 data-cc-t="ingredients">Ingredientes</h3>
            <ul class="cc-m-chips" data-cc-m-chips></ul>
          </div>
          <div class="cc-m-block" data-cc-m-ritual-block hidden>
            <h3 data-cc-t="ritual">Ritual de servicio</h3>
            <p class="cc-m-ritual" data-cc-m-ritual></p>
          </div>
          <div class="cc-m-buy">
            <div class="cc-qty" role="group" aria-label="Cantidad" data-cc-label="qty">
              <button type="button" data-cc-qty="-1" aria-label="−">−</button>
              <output data-cc-m-qty>1</output>
              <button type="button" data-cc-qty="1" aria-label="+">+</button>
            </div>
            <button type="button" class="cc-add" data-cc-add>
              <span data-cc-t="add">AGREGAR A LA BOLSA</span>
              <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5"/></svg>
            </button>
          </div>
          <a class="cc-m-full" data-cc-m-link href="#"><span data-cc-t="full">Ver ficha completa</span> →</a>
          <p class="cc-m-trust" data-cc-t="trust">Entrega con verificación de identidad 21+.</p>
        </div>
      </div>
    </div>

    <div class="cc-cursor" data-cc-cursor aria-hidden="true"><span data-cc-cursor-label></span></div>
  </section>

{%- endpaginate -%}

{%- comment -%} Ingredient sprites (assets/ing-<name>.webp) used by the atmosphere layer {%- endcomment -%}
{%- assign fx_names = 'ice,lime-wheel,lime-half,lemon-wheel,lemon-twist,orange-wheel,orange-peel,grapefruit-half,pineapple-wedge,peach,cranberries,mint,coffee-beans,ginger,coconut-half,agave,sugar-cubes,juniper,cherry,sea-salt,olive,apple' | split: ',' -%}
<script type="application/json" data-cc-fx-assets>
{ {% for fx_name in fx_names %}"{{ fx_name }}": {{ 'ing-' | append: fx_name | append: '.webp' | asset_url | json }}{% unless forloop.last %}, {% endunless %}{% endfor %} }
</script>

<script src="{{ 'can-carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Can Carousel Shop",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Can Carousel Shop"
    }
  ]
}
{% endschema %}
