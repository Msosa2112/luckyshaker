<section class="how-to-enjoy-section" data-section-id="{{ section.id }}">
  <div class="enjoy-container">
    <div class="enjoy-header-center">
      <span class="section-eyebrow">{{ section.settings.eyebrow | default: 'THE SERVING RITUAL' }}</span>
      <h2 class="section-title">{{ section.settings.headline | default: 'How to Enjoy Lucky Shaker' }}</h2>
      <p class="section-subtitle">
        {{ section.settings.subtitle | default: 'Four simple steps to unlock the master mixologist balance sealed inside every bottle.' }}
      </p>
    </div>

    <div class="enjoy-steps-grid">
      <!-- Step 01 -->
      <div class="enjoy-step-card">
        <div class="step-num-pill">01</div>
        <div class="step-icon-wrap">
          {% render 'icon', name: 'star', size: 15, stroke: '#E82B7D', fill: '#E82B7D', stroke_width: 1.5 %}
        </div>
        <h3 class="step-title">{{ section.settings.s4_title | default: 'ENJOY' }}</h3>
        <p class="step-desc">
          {{ section.settings.s4_desc | default: 'Experience uncompromised speakeasy luxury with friends, guests, or during your spontaneous unwind.' }}
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How to Enjoy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE SERVING RITUAL"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "How to Enjoy Lucky Shaker"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Four simple steps to unlock the master mixologist balance sealed inside every bottle."
    },
    {
      "type": "header",
      "content": "Step 1"
    },
    {
      "type": "text",
      "id": "s1_title",
      "label": "Title",
      "default": "CHILL"
    },
    {
      "type": "textarea",
      "id": "s1_desc",
      "label": "Description",
      "default": "Refrigerate the bottle thoroughly to 4°C (40°F) or rest over an ice bath for 20 minutes."
    },
    {
      "type": "header",
      "content": "Step 2"
    },
    {
      "type": "text",
      "id": "s2_title",
      "label": "Title",
      "default": "SHAKE"
    },
    {
      "type": "textarea",
      "id": "s2_desc",
      "label": "Description",
      "default": "Give the bottle 3 to 5 vigorous shakes to fully aerate and homogenize the natural craft botanicals."
    },
    {
      "type": "header",
      "content": "Step 3"
    },
    {
      "type": "text",
      "id": "s3_title",
      "label": "Title",
      "default": "SERVE"
    },
    {
      "type": "textarea",
      "id": "s3_desc",
      "label": "Description",
      "default": "Pour 3.5oz over a crystal ice sphere or chilled rocks glass. Garnish with a citrus peel or fresh herb."
    },
    {
      "type": "header",
      "content": "Step 4"
    },
    {
      "type": "text",
      "id": "s4_title",
      "label": "Title",
      "default": "ENJOY"
    },
    {
      "type": "textarea",
      "id": "s4_desc",
      "label": "Description",
      "default": "Experience uncompromised speakeasy luxury with friends, guests, or during your spontaneous unwind."
    }
  ],
  "presets": [
    {
      "name": "How to Enjoy"
    }
  ]
}
{% endschema %}
