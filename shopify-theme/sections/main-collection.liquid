<section class="page-hero">
  <div class="page-breadcrumbs">
    <a href="{{ routes.root_url }}">Home</a>
    <span>/</span>
    <span>{{ collection.title | default: 'The Signature Collection' }}</span>
  </div>
  <h1 class="page-title">{{ collection.title | default: 'THE SIGNATURE COLLECTION' }}</h1>
  <p class="page-subtitle">
    {{ collection.description | default: 'Artisan-formulated, small-batch ready-to-pour cocktails. Each 750ml bottle yields 6–8 lounge-grade pours with zero artificial preservatives. Simply chill, shake, and serve.' }}
  </p>
</section>

<main class="catalog-container">
  <!-- Filter & Sort Toolbar -->
  <div class="catalog-toolbar">
    <div class="filter-pills" id="filter-pills">
      <button class="filter-btn active" data-filter="all">Todos los Productos</button>
      <button class="filter-btn" data-filter="fruits">Frutas Deshidratadas</button>
      <button class="filter-btn" data-filter="cocktails">Cócteles en Lata</button>
      <button class="filter-btn" data-filter="creams">Crema de Whiskey</button>
    </div>

    <div class="sort-wrapper">
      <label for="catalog-sort">Ordenar por:</label>
      <select id="catalog-sort" class="sort-select" onchange="location = this.value;">
        <option value="{{ collection.url }}?sort_by=manual"{% if collection.sort_by == 'manual' %} selected{% endif %}>Destacados</option>
        <option value="{{ collection.url }}?sort_by=price-ascending"{% if collection.sort_by == 'price-ascending' %} selected{% endif %}>Precio: Menor a Mayor</option>
        <option value="{{ collection.url }}?sort_by=price-descending"{% if collection.sort_by == 'price-descending' %} selected{% endif %}>Precio: Mayor a Menor</option>
        <option value="{{ collection.url }}?sort_by=best-selling"{% if collection.sort_by == 'best-selling' %} selected{% endif %}>Más Vendidos</option>
      </select>
    </div>
  </div>

  <!-- Products Grid (Fruits First Priority) -->
  <div class="products-catalog" id="catalog-grid">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- comment -%} 1. Render All Dehydrated Fruits First {%- endcomment -%}
      {%- for product in collection.products -%}
        {%- if product.handle contains 'dry' or product.type contains 'Fruta' or product.tags contains 'dry-fruits' or product.tags contains 'frutas' or product.title contains 'Fruta' or product.title contains 'Manzana' or product.title contains 'Piña' or product.title contains 'Naranja' or product.title contains 'Limón' or product.handle contains 'manzana' or product.handle contains 'pina' -%}
          {% render 'product-card', product: product %}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} 2. Render All Other Products (Creams & Cocktail Cans) {%- endcomment -%}
      {%- for product in collection.products -%}
        {%- unless product.handle contains 'dry' or product.type contains 'Fruta' or product.tags contains 'dry-fruits' or product.tags contains 'frutas' or product.title contains 'Fruta' or product.title contains 'Manzana' or product.title contains 'Piña' or product.title contains 'Naranja' or product.title contains 'Limón' or product.handle contains 'manzana' or product.handle contains 'pina' -%}
          {% render 'product-card', product: product %}
        {%- endunless -%}
      {%- else -%}
        <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem;">
          <p style="font-size: 1.1rem; color: var(--text-muted);">No se encontraron productos en esta colección.</p>
        </div>
      {%- endfor -%}

      {%- if paginate.pages > 1 -%}
        <div class="pagination-wrapper" style="grid-column: 1 / -1; display: flex; justify-content: center; gap: 0.5rem; margin-top: 3rem;">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</main>

{% schema %}
{
  "name": "Main Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
