<div id="cart-backdrop" class="cart-drawer-backdrop"></div>
<aside id="cart-drawer" class="cart-drawer" aria-label="Bolsa de Compras">
  <div class="cart-drawer-header">
    <div class="cart-drawer-header-left">
      <img src="{{ 'logo_lucky_shaker_dark.svg' | asset_url }}" alt="{{ shop.name }}" class="cart-drawer-logo-img" width="130" height="34" style="height: 32px; width: auto; object-fit: contain;">
      <span id="drawer-count-badge" class="cart-count-pill">{{ cart.item_count }} {% if cart.item_count == 1 %}PRODUCTO{% else %}PRODUCTOS{% endif %}</span>
    </div>
    <button id="close-cart-btn" class="close-drawer-btn" aria-label="Cerrar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Free Shipping Progress Banner -->
  <div id="cart-shipping-banner" class="cart-shipping-banner">
    <div class="cart-shipping-text">
      <span id="shipping-progress-text">Agrega <strong>$80.00</strong> para <strong>Envío Express Gratis</strong></span>
      <span id="shipping-progress-percent" style="font-weight: 700; color: var(--accent-pink);">0%</span>
    </div>
    <div class="cart-shipping-bar-bg">
      <div id="shipping-progress-fill" class="cart-shipping-bar-fill" style="width: 0%;"></div>
    </div>
  </div>

  <!-- Gift With Purchase (GWP) 100ml Promo Banner -->
  <div id="cart-gwp-banner" class="cart-gwp-banner">
    <div class="cart-gwp-header">
      <span class="gwp-badge-icon">🎁</span>
      <span id="gwp-progress-text" class="gwp-text">Agrega <strong>2 productos</strong> para recibir <strong>1 Crema de Whiskey 100ml GRATIS</strong></span>
      <span id="gwp-progress-percent" class="gwp-percent">0/2</span>
    </div>
    <div class="cart-gwp-bar-bg">
      <div id="gwp-progress-fill" class="cart-gwp-bar-fill" style="width: 0%;"></div>
    </div>
  </div>

  <div id="cart-items-list" class="cart-items-container">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty-message">
        <div class="empty-cart-icon-wrap">
          <img src="{{ 'logo_lucky_shaker_dark.svg' | asset_url }}" alt="{{ shop.name }}" width="140" height="38" style="height: 36px; width: auto; object-fit: contain;">
        </div>
        <h4 class="empty-cart-title" data-i18n="cart.empty_title">TU BARRA ESTÁ VACÍA</h4>
        <p class="empty-cart-desc" data-i18n="cart.empty_desc">Explora nuestra colección de botellas para comenzar.</p>
        <a href="{{ routes.all_products_collection_url }}" class="empty-cart-cta">
          <span data-i18n="cart.explore_btn">EXPLORAR CÓCTELES</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M1 7h12M8 2l5 5-5 5"/>
          </svg>
        </a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-item-row" data-line-item-key="{{ item.key }}">
          <div class="cart-item-img-wrap">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title }}" class="cart-item-img" width="68" height="80">
            {%- else -%}
              <div class="cart-item-img" style="background: rgba(0,0,0,0.03);"></div>
            {%- endif -%}
          </div>
          <div class="cart-item-info">
            <h5>{{ item.product.title }}</h5>
            <div class="item-vol">{{ item.variant.title | default: '750ml • Listo para Servir' }}</div>
            <div class="cart-item-actions">
              <div class="cart-item-qty">
                <button type="button" class="qty-btn" onclick="LuckyShakerCart.changeQuantity('{{ item.key }}', {{ item.quantity | minus: 1 }})" aria-label="Disminuir cantidad">&minus;</button>
                <span class="qty-num">{{ item.quantity }}</span>
                <button type="button" class="qty-btn" onclick="LuckyShakerCart.changeQuantity('{{ item.key }}', {{ item.quantity | plus: 1 }})" aria-label="Aumentar cantidad">&plus;</button>
              </div>
              <div class="item-price">{{ item.final_line_price | money }}</div>
            </div>
          </div>
          <button type="button" class="remove-item-btn" onclick="LuckyShakerCart.changeQuantity('{{ item.key }}', 0)" aria-label="Eliminar producto">&times;</button>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="cart-drawer-footer">
    <div class="drawer-subtotal-row">
      <span class="subtotal-label" data-i18n="cart.subtotal">SUBTOTAL</span>
      <span id="drawer-subtotal" class="subtotal-amount">{{ cart.total_price | money }}</span>
    </div>
    <p class="drawer-taxes-note" data-i18n="cart.taxes_note">Impuestos y gastos de envío calculados en la pantalla de pago.</p>
    
    <div class="drawer-actions">
      <button type="button" id="checkout-btn" class="btn btn-pink btn-drawer-checkout" onclick="LuckyShakerCart.proceedToCheckout()">
        <span data-i18n="cart.checkout">FINALIZAR COMPRA</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 7h12M8 2l5 5-5 5"/>
        </svg>
      </button>
      <a href="{{ routes.all_products_collection_url }}" class="continue-shopping-link" onclick="LuckyShakerCart.close();" data-i18n="cart.continue">
        Continuar Explorando &rarr;
      </a>
    </div>

    <div class="cart-trust-badges">
      <span>🔒 Pago Seguro</span>
      <span>📦 Embalaje Protegido 21+</span>
    </div>
  </div>
</aside>

<!-- Toast notification for quick item add -->
<div id="cart-toast" class="cart-toast" role="status" aria-live="polite">
  <div class="toast-content">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
    <span id="toast-message">Cóctel añadido a tu selección</span>
  </div>
</div>
