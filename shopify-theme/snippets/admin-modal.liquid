      gallery: [
        { src: "{{ 'gallery-gender_reveal-1.jpg' | asset_url }}", thumb: "{{ 'gallery-gender_reveal-1-thumb.jpg' | asset_url }}", caption: "Efecto de niebla aromática y nubes de vapor en copas" },
        { src: "{{ 'gallery-gender_reveal-2.jpg' | asset_url }}", thumb: "{{ 'gallery-gender_reveal-2-thumb.jpg' | asset_url }}", caption: "Servicio criogénico en vivo para el momento de la revelación" },
        { src: "{{ 'gallery-gender_reveal-3.jpg' | asset_url }}", thumb: "{{ 'gallery-gender_reveal-3-thumb.jpg' | asset_url }}", caption: "Cócteles de autor tematizados rosa y celeste" },
        { src: "{{ 'gallery-gender_reveal-4.jpg' | asset_url }}", thumb: "{{ 'gallery-gender_reveal-4-thumb.jpg' | asset_url }}", caption: "Brindis con cócteles burbujeantes para los futuros padres" },
        { src: "{{ 'gallery-gender_reveal-5.jpg' | asset_url }}", thumb: "{{ 'gallery-gender_reveal-5-thumb.jpg' | asset_url }}", caption: "Bebidas vírgenes (Mocktails) botánicos para invitados" },
        { src: "{{ 'gallery-gender_reveal-6.jpg' | asset_url }}", thumb: "{{ 'gallery-gender_reveal-6-thumb.jpg' | asset_url }}", caption: "Barra móvil pastel con iluminación decorativa" }
      ]
    },
    negocios: {
      categoryName: "Evento de Negocios",
      categoryDesc: "Mixología profesional de alto volumen, activación de marca en barra y hospitalidad ejecutiva.",
      media: "{{ 'event-real-negocios.jpg' | asset_url }}",
      gallery: [
        { src: "{{ 'gallery-negocios-1.jpg' | asset_url }}", thumb: "{{ 'gallery-negocios-1-thumb.jpg' | asset_url }}", caption: "Torre dorada con cristalería y botánicos deshidratados" },
        { src: "{{ 'gallery-negocios-2.jpg' | asset_url }}", thumb: "{{ 'gallery-negocios-2-thumb.jpg' | asset_url }}", caption: "Estación ejecutiva con ahumado en vivo bajo campana de cristal" },
        { src: "{{ 'gallery-negocios-3.jpg' | asset_url }}", thumb: "{{ 'gallery-negocios-3-thumb.jpg' | asset_url }}", caption: "Carta impresa de coctelería personalizada con branding" },
        { src: "{{ 'gallery-negocios-4.jpg' | asset_url }}", thumb: "{{ 'gallery-negocios-4-thumb.jpg' | asset_url }}", caption: "Degustación guiada de destilados para ejecutivos VIP" },
        { src: "{{ 'gallery-negocios-5.jpg' | asset_url }}", thumb: "{{ 'gallery-negocios-5-thumb.jpg' | asset_url }}", caption: "Servicio ágil de alta capacidad sin filas para galas" }
      ]
    },
    fiestas: {
      categoryName: "Fiestas Privadas",
      categoryDesc: "Eleva cumpleaños, aniversarios y veladas exclusivas con barras móviles privadas y ambientación.",
      media: "{{ 'event-real-fiestas.jpg' | asset_url }}",
      gallery: [
        { src: "{{ 'gallery-fiestas-1.jpg' | asset_url }}", thumb: "{{ 'gallery-fiestas-1-thumb.jpg' | asset_url }}", caption: "Katherin y equipo liderando la barra privada" },
        { src: "{{ 'gallery-fiestas-2.jpg' | asset_url }}", thumb: "{{ 'gallery-fiestas-2-thumb.jpg' | asset_url }}", caption: "Servicio dinámico con coctelería agitada al momento" },
        { src: "{{ 'gallery-fiestas-3.jpg' | asset_url }}", thumb: "{{ 'gallery-fiestas-3-thumb.jpg' | asset_url }}", caption: "Hospitalidad cercana y ambientación de celebración VIP" },
        { src: "{{ 'gallery-fiestas-4.jpg' | asset_url }}", thumb: "{{ 'gallery-fiestas-4-thumb.jpg' | asset_url }}", caption: "Cócteles ahumados en vivo para sorprender a los invitados" },
        { src: "{{ 'gallery-fiestas-5.jpg' | asset_url }}", thumb: "{{ 'gallery-fiestas-5-thumb.jpg' | asset_url }}", caption: "Shots artesanales con sales de cítricos y flores" },
        { src: "{{ 'gallery-fiestas-6.jpg' | asset_url }}", thumb: "{{ 'gallery-fiestas-6-thumb.jpg' | asset_url }}", caption: "Celebración en terraza al aire libre sin preocupaciones" }
      ]
    }
  };

  function getStore() {
    try {
      const raw = window.SafeStorage ? window.SafeStorage.getItem(GALLERY_KEY) : null;
      if (raw) return JSON.parse(raw);
    } catch(e) {}
    return JSON.parse(JSON.stringify(DEFAULT_DATA));
  }

  function setStore(data) {
    try {
      if (window.SafeStorage) window.SafeStorage.setItem(GALLERY_KEY, JSON.stringify(data));
      showNotice("¡Fotos guardadas y sincronizadas con la tienda!", "success");
    } catch(e) {}
  }

  window.openLuckyAdmin = function() {
    const modal = document.getElementById("luckyAdminModal");
    if (modal) {
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
      const isAuth = window.SafeStorage ? window.SafeStorage.getSessionItem(AUTH_KEY) === "true" : false;
      if (isAuth) {
        renderModalDashboard();
      } else {
        document.getElementById("modalAdminLoginWrapper").style.display = "flex";
        document.getElementById("modalAdminDashboardWrapper").style.display = "none";
      }
    }
  };

  window.closeLuckyAdmin = function() {
    const modal = document.getElementById("luckyAdminModal");
    if (modal) {
      modal.style.display = "none";
      document.body.style.overflow = "";
    }
  };

  window.handleModalAdminLogin = function(e) {
    e.preventDefault();
    const u = document.getElementById("modalAdminUser").value.trim();
    const p = document.getElementById("modalAdminPass").value.trim();
    const err = document.getElementById("modalAdminError");

    if (u === ADMIN_USER && p === ADMIN_PASS) {
      if (window.SafeStorage) window.SafeStorage.setSessionItem(AUTH_KEY, "true");
      err.style.display = "none";
      renderModalDashboard();
    } else {
      err.style.display = "flex";
    }
    return false;
  };

  window.handleModalAdminLogout = function() {
    if (window.SafeStorage) window.SafeStorage.removeSessionItem(AUTH_KEY);
    document.getElementById("modalAdminDashboardWrapper").style.display = "none";
    document.getElementById("modalAdminLoginWrapper").style.display = "flex";
  };

  window.toggleModalPassword = function() {
    const p = document.getElementById("modalAdminPass");
    p.type = p.type === "password" ? "text" : "password";
  };

  window.switchModalCategory = function(catKey) {
    activeCat = catKey;
    document.querySelectorAll(".cat-nav-item").forEach(btn => {
      btn.classList.toggle("active", btn.dataset.cat === catKey);
    });
    renderModalPhotos();
  };

  function renderModalDashboard() {
    document.getElementById("modalAdminLoginWrapper").style.display = "none";
    document.getElementById("modalAdminDashboardWrapper").style.display = "block";
    updateModalCounts();
    renderModalPhotos();
  }

  function updateModalCounts() {
    const data = getStore();
    ["bodas", "gender_reveal", "negocios", "fiestas"].forEach(cat => {
      const el = document.getElementById("mcount-" + cat);
      if (el) {
        const count = (data[cat] && data[cat].gallery) ? data[cat].gallery.length : 0;
        el.textContent = count + " fotos";
      }
    });
  }

  function renderModalPhotos() {
    const data = getStore();
    const catData = data[activeCat] || { categoryName: activeCat, gallery: [] };

    document.getElementById("mcurrentCatTitle").textContent = catData.categoryName;
    document.getElementById("mcurrentCatDesc").textContent = catData.categoryDesc || "";
    document.getElementById("mcurrentCatCount").textContent = catData.gallery ? catData.gallery.length : 0;

    const grid = document.getElementById("modalPhotosGrid");
    grid.innerHTML = "";

    if (!catData.gallery || catData.gallery.length === 0) {
      grid.innerHTML = `
        <div style="grid-column: 1/-1; text-align: center; padding: 3rem; background: rgba(255,255,255,0.02); border-radius: 16px;">
          <p style="color: rgba(255,255,255,0.5);">No hay fotos en esta categoría aún. Sube la primera arriba.</p>
        </div>
      `;
      return;
    }

    catData.gallery.forEach((photo, idx) => {
      const card = document.createElement("div");
      card.className = "photo-card";
      card.innerHTML = `
        <div class="photo-thumb-box">
          <img src="${photo.thumb || photo.src}" class="photo-thumb-img" alt="Foto ${idx + 1}" loading="lazy">
        </div>
        <div class="photo-card-body">
          <p class="photo-caption">${escapeHtml(photo.caption || "Sin descripción")}</p>
          <div class="photo-card-actions">
            <button type="button" class="card-action-btn edit-btn" onclick="openModalPhotoEdit(${idx})" title="Editar pie de foto">
              ✏️ Editar Texto
            </button>
            <button type="button" class="card-action-btn delete-btn" onclick="deleteModalPhoto(${idx})" title="Eliminar foto">
              🗑️ Eliminar
            </button>
          </div>
        </div>
      `;
      grid.appendChild(card);
    });

    updateModalCounts();
  }

  window.triggerModalFileUpload = function() {
    document.getElementById("modalFileInput").click();
  };

  function compressImg(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = function(e) {
        const img = new Image();
        img.src = e.target.result;
        img.onload = function() {
          let w = img.width, h = img.height;
          const max = 1600;
          if (w > h && w > max) { h = Math.round((h * max) / w); w = max; }
          else if (h > max) { w = Math.round((w * max) / h); h = max; }

          const cv = document.createElement('canvas');
          cv.width = w; cv.height = h;
          cv.getContext('2d').drawImage(img, 0, 0, w, h);
          const full = cv.toDataURL('image/jpeg', 0.85);

          const thumbCv = document.createElement('canvas');
          const tw = 400, th = Math.round((h * 400) / w);
          thumbCv.width = tw; thumbCv.height = th;
          thumbCv.getContext('2d').drawImage(img, 0, 0, tw, th);
          const thumb = thumbCv.toDataURL('image/jpeg', 0.8);

          resolve({
            src: full,
            thumb: thumb,
            caption: file.name.replace(/\.[^/.]+$/, "").replace(/[-_]/g, " ")
          });
        };
        img.onerror = reject;
      };
      reader.onerror = reject;
    });
  }

  window.handleModalFilesSelected = async function(e) {
    const files = e.target.files;
    if (!files || files.length === 0) return;

    showNotice(`Procesando ${files.length} foto(s)...`, "success");
    const data = getStore();
    if (!data[activeCat]) data[activeCat] = { categoryName: activeCat, gallery: [] };

    try {
      for (let i = 0; i < files.length; i++) {
        const photo = await compressImg(files[i]);
        data[activeCat].gallery.unshift(photo);
      }
      setStore(data);
      renderModalPhotos();
      showNotice(`¡${files.length} foto(s) agregada(s) con éxito!`, "success");
    } catch(err) {
      alert("Error al procesar: " + err.message);
    }
    e.target.value = "";
  };

  window.deleteModalPhoto = function(idx) {
    if (!confirm("¿Deseas eliminar esta foto de la galería?")) return;
    const data = getStore();
    if (data[activeCat] && data[activeCat].gallery) {
      data[activeCat].gallery.splice(idx, 1);
      setStore(data);
      renderModalPhotos();
    }
  };

  window.openModalPhotoEdit = function(idx) {
    editingIdx = idx;
    const data = getStore();
    const p = data[activeCat].gallery[idx];
    document.getElementById("modalEditPreviewImg").src = p.src;
    document.getElementById("modalEditCaptionInput").value = p.caption || "";
    document.getElementById("modalPhotoEditModal").style.display = "flex";
  };

  window.closeModalEditModal = function() {
    document.getElementById("modalPhotoEditModal").style.display = "none";
    editingIdx = null;
  };

  window.saveModalPhotoEdit = function() {
    if (editingIdx === null) return;
    const data = getStore();
    const newCap = document.getElementById("modalEditCaptionInput").value.trim();
    if (data[activeCat] && data[activeCat].gallery && data[activeCat].gallery[editingIdx]) {
      data[activeCat].gallery[editingIdx].caption = newCap;
      setStore(data);
      renderModalPhotos();
      closeModalEditModal();
    }
  };

  window.exportModalGalleryJson = function() {
    const data = getStore();
    const str = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(data, null, 2));
    const a = document.createElement('a');
    a.href = str;
    a.download = "lucky-shaker-gallery-backup.json";
    document.body.appendChild(a);
    a.click();
    a.remove();
  };

  window.resetModalDefaultPhotos = function() {
    if (!confirm("¿Restablecer fotos a la galería original?")) return;
    setStore(DEFAULT_DATA);
    renderModalPhotos();
  };

  function showNotice(msg, type) {
    const el = document.getElementById("modalAdminNotice");
    if (!el) return;
    el.textContent = msg;
    el.className = "admin-notice " + type;
    el.style.display = "block";
    setTimeout(() => { el.style.display = "none"; }, 3500);
  }

  function escapeHtml(t) {
    const d = document.createElement('div');
    d.textContent = t;
    return d.innerHTML;
  }

  // Check URL hash for direct admin trigger
  if (window.location.hash === '#admin' || window.location.hash === '#admin-panel') {
    setTimeout(window.openLuckyAdmin, 300);
  }
})();
</script>
