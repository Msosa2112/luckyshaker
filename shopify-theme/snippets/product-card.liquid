{%- comment -%}
  LUCKY SHAKER — LUXURY EDITORIAL PRODUCT CARD
  Apple Liquid Glass Light Theme Design System
{%- endcomment -%}

{%- assign clean_title = product.title | replace: ' 750ml', '' | replace: ' 750ML', '' | replace: ' 750 ml', '' -%}

{%- comment -%} Extract Clean Single-Line ABV {%- endcomment -%}
{%- assign abv_val = '16% ABV' -%}
{%- if product.description contains 'ABV:</strong>' -%}
  {%- assign abv_split = product.description | split: 'ABV:</strong> ' | last | split: '</li>' | first | split: '<' | first -%}
  {%- if abv_split != blank -%}
    {%- assign abv_val = abv_split | strip | replace: 'Alc / Vol', 'ABV' | replace: 'Alc/Vol', 'ABV' | replace: 'ALC / VOL', 'ABV' | replace: 'Alc / vol', 'ABV' | replace: 'alc / vol', 'ABV' -%}
  {%- endif -%}
{%- elsif product.metafields.custom.abv != blank -%}
  {%- assign abv_val = product.metafields.custom.abv | replace: 'Alc / Vol', 'ABV' | replace: 'Alc/Vol', 'ABV' | replace: 'ALC / VOL', 'ABV' -%}
  {%- assign abv_val = product.metafields.custom.abv | replace: 'Alc / Vol', 'ABV' | replace: 'Alc/Vol', 'ABV' | replace: 'ALC / VOL', 'ABV' -%}
{%- endif -%}

{%- comment -%} Extract Tasting Notes / Ingredients line {%- endcomment -%}
{%- assign notes_line = '' -%}
{%- if product.description contains 'Ingredients:</strong>' -%}
  {%- assign notes_line = product.description | split: 'Ingredients:</strong> ' | last | split: '</li>' | first | split: '<' | first | replace: ',', ' · ' -%}
{%- endif -%}

{%- comment -%} Resolve a single image source (used for the visible image and the blurred ambient backdrop) {%- endcomment -%}
{%- if product.featured_image -%}
  {%- assign card_img_src = product.featured_image | image_url: width: 800 -%}
{%- elsif product.handle == 'whiskey-cream' -%}
  {%- assign card_img_src = 'prod-whiskey-cream.png' | asset_url -%}
{%- else -%}
  {%- assign fallback_img = 'prod-' | append: product.handle | append: '.jpg' -%}
  {%- assign card_img_src = fallback_img | asset_url -%}
{%- endif -%}

<article class="product-item luxury-glass-card" data-product-id="{{ product.id }}">
  <img class="product-ambient" src="{{ card_img_src }}" alt="" aria-hidden="true" loading="lazy" width="40" height="48">
  <!-- Product Image Container -->
  <div class="product-visual-box">
    <div class="product-badge-group">
      <span class="product-visual-badge glass-badge">{{ abv_val }}</span>
      {%- if product.tags contains 'Best Seller' or product.tags contains 'Featured' -%}
        <span class="product-visual-badge bestseller-badge" data-i18n="shop.bestseller">MÁS VENDIDO</span>
      {%- endif -%}
    </div>

    <a href="{{ product.url }}" class="product-visual-link" aria-label="{{ product.title }}">
      {%- if product.featured_image -%}
        <img src="{{ card_img_src }}" alt="{{ product.title }}" class="product-img" loading="lazy" width="400" height="480">
      {%- elsif product.handle == 'whiskey-cream' -%}
        <img src="{{ card_img_src }}" alt="{{ product.title }}" class="product-img" loading="lazy" width="400" height="480">
      {%- else -%}
        <img src="{{ card_img_src }}" alt="{{ product.title }}" class="product-img" loading="lazy" width="400" height="480" onerror="this.onerror=null; this.src='{{ 'margarita.jpg' | asset_url }}';">
      {%- endif -%}
    </a>
    <span class="product-glare" aria-hidden="true"></span>
  </div>

  <!-- Compact Editorial Details Area -->
  <div class="product-details">
    {%- liquid
      assign is_cream = false
      assign is_fruit = false
      assign is_can = true

      if product.handle == 'whiskey-cream' or product.type contains 'Crema'
        assign is_cream = true
        assign is_can = false
      elsif product.handle contains 'dry' or product.type contains 'Fruta' or product.tags contains 'dry-fruits'
        assign is_fruit = true
        assign is_can = false
      endif
    -%}

    <div class="product-eyebrow-row">
      {%- if is_cream -%}
        <span class="product-category-label">CREMA DE AUTOR</span>
        <span class="product-dot-sep">•</span>
        <span class="product-vol-label">750ML &bull; 375ML</span>
      {%- elsif is_fruit -%}
        <span class="product-category-label">FRUTAS DISECADAS</span>
        <span class="product-dot-sep">•</span>
        <span class="product-vol-label">60 GRAMOS</span>
      {%- else -%}
        <span class="product-category-label">CÓCTEL ARTESANAL</span>
        <span class="product-dot-sep">•</span>
        <span class="product-vol-label">LATA 355 ML</span>
      {%- endif -%}
    </div>

    <h3 class="product-name">
      <a href="{{ product.url }}">{{ clean_title }}</a>
    </h3>

    {%- if notes_line != blank -%}
      {%- assign note_chips = notes_line | split: ' · ' -%}
      <ul class="product-notes-chips" aria-label="Ingredientes">
        {%- for chip in note_chips limit: 4 -%}
          {%- assign chip_clean = chip | strip -%}
          {%- if chip_clean != blank -%}<li>{{ chip_clean }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- elsif product.description != blank -%}
      <p class="product-tasting-notes">{{ product.description | strip_html | truncatewords: 8 }}</p>
    {%- else -%}
      <p class="product-tasting-notes" data-i18n="shop.default_notes">Cóctel artesanal de autor listo para disfrutar</p>
    {%- endif -%}

    <!-- Card Format & Pricing Summary -->
    <div class="product-pricing-summary">
      {%- if is_cream -%}
        <div class="price-format-pill">
          <span class="price-amount">$35.00</span>
          <span class="price-detail">750ml / 375ml $18.99</span>
        </div>
      {%- elsif is_fruit -%}
        <div class="price-format-pill">
          <span class="price-amount">$8.75</span>
          <span class="price-detail">Paquete 60g</span>
        </div>
      {%- else -%}
        <div class="price-format-pill">
          <span class="price-amount">$35.99</span>
          <span class="price-detail">Pack de 6 Latas (355ml c/u)</span>
        </div>
        {%- if product.handle != 'old-fashioned' -%}
          <span class="mocktail-avail-badge" title="Disponible versión sin alcohol por $29.99 el pack">Mocktail Sin Alcohol $29.99</span>
        {%- endif -%}
      {%- endif -%}
    </div>

    <!-- Product Card Footer (Add to Bag Action) -->
    <div class="product-card-footer">
      <div class="product-action-box" style="width: 100%;">
        {%- if product.available -%}
          {%- liquid
            assign default_add_price = '$35.99'
            if is_cream
              assign default_add_price = '$35.00'
            elsif is_fruit
              assign default_add_price = '$8.75'
            endif
          -%}
          <button type="button" class="btn btn-luxury-pink add-to-bag-btn" style="width: 100%; justify-content: center;" onclick="LuckyShakerCart.addItem({{ product.selected_or_first_available_variant.id }}, 1, '{{ product.title | escape }}', '{{ default_add_price }}')" aria-label="Agregar {{ clean_title }} a la Bolsa">
            <span data-i18n="shop.add_bag">AGREGAR A LA BOLSA</span>
            <svg class="btn-arrow" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 7h12M8 2l5 5-5 5"/>
            </svg>
          </button>
        {%- else -%}
          <button type="button" class="btn btn-luxury-pink is-soldout" style="width: 100%; justify-content: center;" disabled>
            <span data-i18n="shop.sold_out">AGOTADO</span>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</article>
